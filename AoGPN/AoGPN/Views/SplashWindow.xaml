<Window
    x:Class="AoGPN.Views.SplashWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="AO GPN"
    Width="660"
    Height="500"
    WindowStyle="None"
    ResizeMode="NoResize"
    ShowInTaskbar="False"
    WindowStartupLocation="CenterScreen"
    Topmost="True"
    AllowsTransparency="True"
    Background="Transparent"
    SnapsToDevicePixels="True"
    UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- The logo itself: the transparent high-res AO GPN png, no backdrop. -->
        <Image
            Source="pack://application:,,,/Resources/Splash.png"
            Stretch="Uniform"
            RenderOptions.BitmapScalingMode="HighQuality"
            Margin="20,10,20,8" />

        <Grid Grid.Row="1" Margin="0,0,0,22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Boot status text -->
            <TextBlock
                x:Name="StatusText"
                Text="Başlatılıyor…"
                HorizontalAlignment="Center"
                Foreground="#8A8F98"
                FontSize="12"
                FontFamily="Segoe UI Variable Text" />

            <!-- Loading bar -->
            <ProgressBar
                x:Name="BootProgress"
                Grid.Row="1"
                Margin="190,12,190,0"
                Height="6"
                Minimum="0"
                Maximum="100"
                Value="0">
                <ProgressBar.Template>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid ClipToBounds="true" SnapsToDevicePixels="true">
                            <Border
                                x:Name="PART_Track"
                                Background="#16212E"
                                CornerRadius="3" />
                            <Border
                                x:Name="PART_Indicator"
                                CornerRadius="3"
                                HorizontalAlignment="Left">
                                <Border.Background>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Offset="0" Color="#00E5FF" />
                                        <GradientStop Offset="0.6" Color="#7C4DFF" />
                                        <GradientStop Offset="1" Color="#FF2E97" />
                                    </LinearGradientBrush>
                                </Border.Background>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </ProgressBar.Template>
            </ProgressBar>

            <!-- Version -->
            <TextBlock
                x:Name="VersionText"
                Grid.Row="2"
                Margin="0,12,0,0"
                HorizontalAlignment="Center"
                Foreground="#8A8F98"
                FontSize="11"
                FontFamily="Segoe UI Variable Text" />
        </Grid>
    </Grid>
</Window>