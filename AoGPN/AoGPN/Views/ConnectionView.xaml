<reactiveui:ReactiveUserControl
    x:Class="AoGPN.Views.ConnectionView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="clr-namespace:AoGPN.Converters"
    xmlns:controls="clr-namespace:AoGPN.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    x:TypeArguments="vms:SplitTunnelViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />
        <conv:ExePathToIconConverter x:Key="ExeIcon" />

        <!-- Shared route badge: shows the effective route (proxy / direct / block) with a color per route. -->
        <DataTemplate x:Key="RouteBadgeTemplate">
            <Border Margin="2,2" Padding="8,1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF607D8B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding RouteTag}" Value="proxy">
                                <Setter Property="Background" Value="#FF1565C0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RouteTag}" Value="direct">
                                <Setter Property="Background" Value="#FF2E7D32" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding RouteTag}" Value="block">
                                <Setter Property="Background" Value="#FFC62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" Foreground="White" Text="{Binding RouteText}" />
            </Border>
        </DataTemplate>

        <!-- Live connection badge: the route of the app's actual active connections. -->
        <DataTemplate x:Key="LiveRouteBadgeTemplate">
            <Border Margin="2,2" Padding="8,1" CornerRadius="8">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FF607D8B" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding LiveRouteTag}" Value="proxy">
                                <Setter Property="Background" Value="#FF1565C0" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LiveRouteTag}" Value="direct">
                                <Setter Property="Background" Value="#FF2E7D32" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding LiveRouteTag}" Value="block">
                                <Setter Property="Background" Value="#FFC62828" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock HorizontalAlignment="Center" Foreground="White" Text="{Binding LiveRouteText}" />
            </Border>
        </DataTemplate>

        <Style x:Key="SectionCard" TargetType="{x:Type Border}">
            <Setter Property="Margin" Value="0,0,0,10" />
            <Setter Property="Padding" Value="16,12" />
            <Setter Property="Background" Value="{StaticResource GlassPanelBg}" />
            <Setter Property="BorderBrush" Value="{StaticResource GlassEdgeBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
        </Style>
        <Style x:Key="SectionTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize4}" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style
            x:Key="SectionHint"
            BasedOn="{StaticResource ListItemSubTitle2}"
            TargetType="{x:Type TextBlock}">
            <Setter Property="Margin" Value="0,2,0,0" />
            <Setter Property="Opacity" Value="0.62" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- Modern segmented mode selector -->
        <Style x:Key="ModeSegment" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#7E8A9E" />
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize1}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="Bd"
                            Padding="18,9"
                            Background="#191E26"
                            BorderBrush="#2A3140"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#202733" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource GpnViolet}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource GpnViolet}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="GradientButton" BasedOn="{StaticResource DefButton}" TargetType="{x:Type ButtonBase}">
            <Setter Property="Background" Value="{StaticResource GpnViolet}" />
            <Setter Property="Foreground" Value="White" />
        </Style>

        <!-- AoGPN telemetry dashboard: glass cards, big tabular numbers, glowing gauges -->
        <Style x:Key="TelemetryCard" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#12FFFFFF" />
            <Setter Property="BorderBrush" Value="#26FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>
        <Style x:Key="TelemetryLabel" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#8A94A6" />
        </Style>
        <Style x:Key="TelemetryValue" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#F1F5F9" />
        </Style>
        <Style x:Key="TelemetryUnit" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
            <Setter Property="Foreground" Value="#8A94A6" />
        </Style>
        <Style x:Key="TelemetrySub" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
            <Setter Property="Foreground" Value="#8A94A6" />
        </Style>
        <Style x:Key="TelemetryHint" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="{DynamicResource StdFontSize-1}" />
            <Setter Property="Foreground" Value="#5B6472" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!-- AoGPN connection center: mode pills, status pills, game tiles -->
        <LinearGradientBrush x:Key="ModePillActive" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Offset="0" Color="#477C4DFF" />
            <GradientStop Offset="1" Color="#3000B8D4" />
        </LinearGradientBrush>
        <Style x:Key="ModePill" TargetType="{x:Type RadioButton}">
            <Setter Property="Foreground" Value="#A7B0BF" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type RadioButton}">
                        <Border
                            x:Name="Bd"
                            Padding="16,8"
                            Background="#12161F"
                            BorderBrush="#2A3140"
                            BorderThickness="1"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1A202B" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ModePillActive}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#8A7C4DFF" />
                                <Setter Property="Foreground" Value="#A5F3FC" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="StatusPill" TargetType="{x:Type Border}">
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="99" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="#1A22D3EE" />
            <Setter Property="BorderBrush" Value="#4022D3EE" />
        </Style>
        <Style x:Key="GameTile" TargetType="{x:Type Border}">
            <Setter Property="Background" Value="#14FFFFFF" />
            <Setter Property="BorderBrush" Value="#1FFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>
    </UserControl.Resources>

    <Grid>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="12">

                <!-- ============ PAGE TITLE (AoGPN design header) ============ -->
                <Grid Margin="2,0,2,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock
                            FontSize="26"
                            FontWeight="Bold"
                            Foreground="#F1F5F9"
                            TextTrimming="CharacterEllipsis">
                            <Run Text="Connection " />
                            <Run
                                Foreground="{StaticResource BrandTextGradient}"
                                Text="Center" />
                        </TextBlock>
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="#8A94A6"
                            Text="Realtime tunnel status · low-latency game routing" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                        <Border>
                            <Border.Style>
                                <Style BasedOn="{StaticResource StatusPill}" TargetType="{x:Type Border}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                            <Setter Property="Background" Value="#1A34D399" />
                                            <Setter Property="BorderBrush" Value="#4034D399" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="8" Height="8" VerticalAlignment="Center">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="#22D3EE" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                                    <Setter Property="Fill" Value="#34D399" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding Telemetry.StatusText}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="#67E8F9" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                                    <Setter Property="Foreground" Value="#6EE7B7" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </Border>
                        <Border Margin="8,0,0,0" Style="{StaticResource StatusPill}">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="#22D3EE">
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        Duration="0:0:0.8"
                                                        From="1"
                                                        To="0.3" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                                <TextBlock
                                    Margin="7,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="#67E8F9"
                                    Text="CANLI" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- ============ CONNECTION CENTER (AoGPN design) ============ -->
                <Border ClipToBounds="True" Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- decorative ambient blobs (design) -->
                        <Ellipse
                            Grid.ColumnSpan="2"
                            Width="280"
                            Height="280"
                            Margin="0,-140,-140,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            IsHitTestVisible="False"
                            Opacity="0.5">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#1A7C4DFF" />
                                    <GradientStop Offset="1" Color="#007C4DFF" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse
                            Grid.ColumnSpan="2"
                            Width="260"
                            Height="260"
                            Margin="-140,0,0,-120"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            IsHitTestVisible="False"
                            Opacity="0.45">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Offset="0" Color="#2600B8D4" />
                                    <GradientStop Offset="1" Color="#0000B8D4" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <!-- CONNECT RING -->
                        <Grid
                            Width="216"
                            Height="216"
                            Margin="12,6,26,6"
                            VerticalAlignment="Center">
                            <!-- rotating arc (design ring-spin) -->
                            <Grid>
                                <Grid.RenderTransform>
                                    <RotateTransform x:Name="ringSpin" />
                                </Grid.RenderTransform>
                                <Grid.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetName="ringSpin"
                                                    Storyboard.TargetProperty="Angle"
                                                    Duration="0:0:4"
                                                    From="0"
                                                    To="360" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Grid.Triggers>
                                <controls:RingGauge
                                    x:Name="ringArc"
                                    Width="216"
                                    Height="216"
                                    Thickness="5"
                                    Value="0.16">
                                    <controls:RingGauge.Style>
                                        <Style TargetType="controls:RingGauge">
                                            <Setter Property="Color" Value="{StaticResource GpnCyan}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                                    <Setter Property="Color" Value="{StaticResource GpnGreen}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </controls:RingGauge.Style>
                                </controls:RingGauge>
                            </Grid>
                            <!-- pulse halo (design ring-pulse) -->
                            <Ellipse x:Name="ringPulse" Margin="2">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill">
                                            <Setter.Value>
                                                <RadialGradientBrush>
                                                    <GradientStop Offset="0" Color="#0006B6D4" />
                                                    <GradientStop Offset="0.7" Color="#0006B6D4" />
                                                    <GradientStop Offset="0.82" Color="#3306B6D4" />
                                                    <GradientStop Offset="1" Color="#0006B6D4" />
                                                </RadialGradientBrush>
                                            </Setter.Value>
                                        </Setter>
                                        <Setter Property="Effect">
                                            <Setter.Value>
                                                <DropShadowEffect
                                                    BlurRadius="26"
                                                    Color="#06B6D4"
                                                    Opacity="0.55"
                                                    ShadowDepth="0" />
                                            </Setter.Value>
                                        </Setter>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Telemetry.IsConnected}" Value="True">
                                                <Setter Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect
                                                            BlurRadius="28"
                                                            Color="#34D399"
                                                            Opacity="0.6"
                                                            ShadowDepth="0" />
                                                    </Setter.Value>
                                                </Setter>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                                <Ellipse.Triggers>
                                    <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                        <BeginStoryboard>
                                            <Storyboard AutoReverse="True" RepeatBehavior="Forever">
                                                <DoubleAnimation
                                                    Storyboard.TargetProperty="Opacity"
                                                    Duration="0:0:1.2"
                                                    From="0.9"
                                                    To="0.45" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Ellipse.Triggers>
                            </Ellipse>
                            <!-- center button (design ring-core) -->
                            <Button
                                x:Name="btnConnectRing"
                                Width="164"
                                Height="164"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand">
                                <Button.Template>
                                    <ControlTemplate TargetType="{x:Type Button}">
                                        <Border
                                            x:Name="Core"
                                            Width="164"
                                            Height="164"
                                            BorderBrush="#557C4DFF"
                                            BorderThickness="1"
                                            CornerRadius="82">
                                            <Border.Background>
                                                <RadialGradientBrush GradientOrigin="0.32,0.28">
                                                    <GradientStop Offset="0" Color="#387C4DFF" />
                                                    <GradientStop Offset="0.6" Color="#E60B0F19" />
                                                    <GradientStop Offset="1" Color="#0B0F19" />
                                                </RadialGradientBrush>
                                            </Border.Background>
                                            <Border.Effect>
                                                <DropShadowEffect
                                                    BlurRadius="22"
                                                    Color="#06B6D4"
                                                    Opacity="0.5"
                                                    ShadowDepth="0" />
                                            </Border.Effect>
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon
                                                    x:Name="CoreIcon"
                                                    Width="34"
                                                    Height="34"
                                                    HorizontalAlignment="Center"
                                                    Foreground="#67E8F9"
                                                    Kind="Play" />
                                                <TextBlock
                                                    x:Name="CoreText"
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="20"
                                                    FontWeight="Bold"
                                                    Foreground="#A5F3FC"
                                                    Text="CONNECT" />
                                                <TextBlock
                                                    x:Name="CoreSub"
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    Foreground="#8A94A6"
                                                    Text="GLOBAL VPN" />
                                            </StackPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Core" Property="BorderBrush" Value="#80A5F3FC" />
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter TargetName="Core" Property="BorderBrush" Value="#FFC4B5FD" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </Grid>

                        <!-- Right side -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <!-- Hybrid mode toggle -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    x:Name="btnPillVpn"
                                    GroupName="PillMode"
                                    Style="{StaticResource ModePill}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="ShieldOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="Global VPN" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="btnPillGpn"
                                    Margin="8,0,0,0"
                                    GroupName="PillMode"
                                    Style="{StaticResource ModePill}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="LightningBoltOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="GPN Game Tunnel" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>

                            <!-- Info cards -->
                            <UniformGrid Columns="3" Margin="0,18,0,0">
                                <Border Margin="0,0,6,0" Style="{StaticResource TelemetryCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TelemetryLabel}" Text="DÜĞÜM" />
                                        <TextBlock
                                            x:Name="txtNodeName"
                                            Margin="0,5,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#F1F5F9"
                                            Text="—"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="txtNodeSub"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="#8A94A6"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="6,0,6,0" Style="{StaticResource TelemetryCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TelemetryLabel}" Text="PROTOKOL" />
                                        <TextBlock
                                            x:Name="txtProtoName"
                                            Margin="0,5,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#F1F5F9"
                                            Text="Global VPN Tunnel" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="#8A94A6"
                                            Text="TCP + UDP · TUN" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="6,0,0,0" Style="{StaticResource TelemetryCard}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TelemetryLabel}" Text="OTURUM" />
                                        <TextBlock
                                            x:Name="txtSessionTime"
                                            Margin="0,5,0,0"
                                            FontSize="14"
                                            FontWeight="SemiBold"
                                            Foreground="#F1F5F9"
                                            Text="00:00:00" />
                                        <TextBlock
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="#8A94A6"
                                            Text="uptime" />
                                    </StackPanel>
                                </Border>
                            </UniformGrid>

                            <TextBlock
                                Margin="0,16,0,0"
                                Style="{StaticResource SectionHint}"
                                Text="Tünel en yakın düğüm üzerinden kurulur; oyun trafiği düşük gecikmeli GPN omurgasından, diğer trafik VPN kural setinden geçer." />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ============ GPN GAME BOOST (AoGPN design) ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource GpnViolet}"
                                    Kind="LightningBoltOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="GPN GAME BOOST" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                Padding="10,3"
                                Background="#1A00E676"
                                BorderBrush="#3334D399"
                                BorderThickness="1"
                                CornerRadius="99"
                                VerticalAlignment="Center">
                                <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="#6EE7B7" Text="2 oyun hızlandırılıyor" />
                            </Border>
                        </Grid>
                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SectionHint}"
                            Text="Oyunların için düşük gecikmeli rota önceliği — oyun başladığında otomatik hızlandırma devreye girer." />

                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <Border Margin="0,0,5,0" Style="{StaticResource GameTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38"
                                        Height="38"
                                        Background="{StaticResource GpnVioletSoft}"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#67E8F9"
                                            Text="EFT" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#F1F5F9"
                                            Text="Escape from Tarkov"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#8A94A6" Text="Rota: VPN · düşük gecikme" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="#34D399" />
                                </Grid>
                            </Border>
                            <Border Margin="5,0,5,0" Style="{StaticResource GameTile}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Width="38"
                                        Height="38"
                                        Background="{StaticResource GpnCyanSoft}"
                                        CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#67E8F9"
                                            Text="VAL" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="#F1F5F9"
                                            Text="Valorant"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#8A94A6" Text="Rota: VPN · düşük gecikme" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="#34D399" />
                                </Grid>
                            </Border>
                            <Border Margin="5,0,5,0" Style="{StaticResource GameTile}" Opacity="0.6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="#14FFFFFF" CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#8A94A6"
                                            Text="CS" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#A7B0BF" Text="Counter-Strike 2" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#5B6472" Text="Idle · boost yok" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="#3A4152" />
                                </Grid>
                            </Border>
                            <Border Margin="5,0,0,0" Style="{StaticResource GameTile}" Opacity="0.6">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="38" Height="38" Background="#14FFFFFF" CornerRadius="10">
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            FontSize="13"
                                            FontWeight="Bold"
                                            Foreground="#8A94A6"
                                            Text="FN" />
                                    </Border>
                                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="#A7B0BF" Text="Fortnite" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="#5B6472" Text="Idle · boost yok" />
                                    </StackPanel>
                                    <Ellipse Grid.Column="2" Width="8" Height="8" VerticalAlignment="Center" Fill="#3A4152" />
                                </Grid>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============ LIVE TELEMETRY (AoGPN dashboard) ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource GpnCyan}"
                                    Kind="ChartTimelineVariant" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="CANLI TELEMETRİ" />
                                <Ellipse
                                    Width="8"
                                    Height="8"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Fill="#22D3EE">
                                    <Ellipse.Effect>
                                        <DropShadowEffect
                                            BlurRadius="8"
                                            Color="#22D3EE"
                                            Opacity="0.9"
                                            ShadowDepth="0" />
                                    </Ellipse.Effect>
                                    <Ellipse.Triggers>
                                        <EventTrigger RoutedEvent="FrameworkElement.Loaded">
                                            <BeginStoryboard>
                                                <Storyboard
                                                    AutoReverse="True"
                                                    RepeatBehavior="Forever">
                                                    <DoubleAnimation
                                                        Storyboard.TargetProperty="Opacity"
                                                        Duration="0:0:0.8"
                                                        From="1"
                                                        To="0.35" />
                                                </Storyboard>
                                            </BeginStoryboard>
                                        </EventTrigger>
                                    </Ellipse.Triggers>
                                </Ellipse>
                            </StackPanel>
                        </Grid>

                        <TextBlock
                            Margin="0,4,0,0"
                            Style="{StaticResource SectionHint}"
                            Text="Son 60 saniyenin canlı ping ve hız dalgalanması — bağlıyken ölçülür" />

                        <UniformGrid Columns="4" Margin="0,14,0,0">
                            <!-- PING -->
                            <Border Margin="0,0,5,0" Style="{StaticResource TelemetryCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TelemetryLabel}" Text="PING" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TelemetryValue}" Text="{Binding Telemetry.PingText}" />
                                        <TextBlock
                                            Margin="4,0,0,3"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource TelemetryUnit}"
                                            Text="ms" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource TelemetrySub}"
                                        Text="{Binding Telemetry.PingQuality}" />
                                    <controls:Sparkline
                                        x:Name="sparkPing"
                                        Height="34"
                                        Margin="0,10,0,0"
                                        LineBrush="{StaticResource GpnCyan}" />
                                </StackPanel>
                            </Border>

                            <!-- PACKET LOSS -->
                            <Border Margin="5,0,5,0" Style="{StaticResource TelemetryCard}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource TelemetryLabel}" Text="PAKET KAYBI" />
                                    <StackPanel Margin="0,5,0,0" Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource TelemetryValue}" Text="{Binding Telemetry.LossText}" />
                                        <TextBlock
                                            Margin="4,0,0,3"
                                            VerticalAlignment="Bottom"
                                            Style="{StaticResource TelemetryUnit}"
                                            Text="%" />
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,2,0,0"
                                        Style="{StaticResource TelemetrySub}"
                                        Text="{Binding Telemetry.LossQuality}" />
                                    <TextBlock
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Center"
                                        Style="{StaticResource TelemetryHint}"
                                        Text="ping zaman aşımından tahmin edilir" />
                                </StackPanel>
                            </Border>

                            <!-- DOWNLOAD -->
                            <Border Margin="5,0,5,0" Style="{StaticResource TelemetryCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TelemetryLabel}" Text="İNDİRME" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource GpnCyan}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TelemetryValue}" Text="{Binding Telemetry.DownText}" />
                                            <TextBlock
                                                Margin="4,0,0,3"
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource TelemetryUnit}"
                                                Text="Mbps" />
                                        </StackPanel>
                                        <controls:RingGauge
                                            Grid.Column="1"
                                            Width="50"
                                            Height="50"
                                            Color="{StaticResource GpnCyan}"
                                            Thickness="6"
                                            Value="{Binding Telemetry.DownFraction}" />
                                    </Grid>
                                    <controls:Sparkline
                                        x:Name="sparkDown"
                                        Height="34"
                                        Margin="0,10,0,0"
                                        LineBrush="{StaticResource GpnCyan}" />
                                </StackPanel>
                            </Border>

                            <!-- UPLOAD -->
                            <Border Margin="5,0,0,0" Style="{StaticResource TelemetryCard}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource TelemetryLabel}" Text="YÜKLEME" />
                                        <Ellipse
                                            Grid.Column="1"
                                            Width="7"
                                            Height="7"
                                            VerticalAlignment="Center"
                                            Fill="{StaticResource GpnViolet}" />
                                    </Grid>
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource TelemetryValue}" Text="{Binding Telemetry.UpText}" />
                                            <TextBlock
                                                Margin="4,0,0,3"
                                                VerticalAlignment="Bottom"
                                                Style="{StaticResource TelemetryUnit}"
                                                Text="Mbps" />
                                        </StackPanel>
                                        <controls:RingGauge
                                            Grid.Column="1"
                                            Width="50"
                                            Height="50"
                                            Color="{StaticResource GpnViolet}"
                                            Thickness="6"
                                            Value="{Binding Telemetry.UpFraction}" />
                                    </Grid>
                                    <controls:Sparkline
                                        x:Name="sparkUp"
                                        Height="34"
                                        Margin="0,10,0,0"
                                        LineBrush="{StaticResource GpnViolet}" />
                                </StackPanel>
                            </Border>
                        </UniformGrid>
                    </StackPanel>
                </Border>

                <!-- ============ CONNECTION MODE ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{StaticResource GpnViolet}"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Style="{StaticResource SectionTitle}"
                                    Text="{x:Static resx:ResUI.ConnectionModeLabel}" />
                            </StackPanel>
                            <ComboBox
                                x:Name="cmbMode"
                                Grid.Column="1"
                                Width="0"
                                Height="0"
                                Visibility="Collapsed" />
                        </Grid>
                        <TextBlock Style="{StaticResource SectionHint}" Text="{x:Static resx:ResUI.ConnectionModeHint}" />

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <RadioButton x:Name="btnModeOff" Style="{StaticResource ModeSegment}" Content="{x:Static resx:ResUI.ConnectionModeOff}" />
                            <RadioButton x:Name="btnModeVpn" Style="{StaticResource ModeSegment}" Content="{x:Static resx:ResUI.ConnectionModeVpn}" />
                            <RadioButton x:Name="btnModeManual" Style="{StaticResource ModeSegment}" Content="{x:Static resx:ResUI.ConnectionModeManual}" />
                        </StackPanel>

                        <Border
                            x:Name="pnlVpnHint"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource ListItemSubTitle2}"
                                Text="{x:Static resx:ResUI.ConnectionVpnHint}"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="pnlManualHint"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="{DynamicResource MaterialDesign.Brush.Secondary.Light}"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                Style="{StaticResource ListItemSubTitle2}"
                                Text="{x:Static resx:ResUI.ConnectionManualHint}"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="pnlNeedAdmin"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="#3A2A2A"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        VerticalAlignment="Center"
                                        Foreground="#F28B82"
                                        Kind="ShieldAlert" />
                                    <TextBlock
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="#F28B82"
                                        Text="{x:Static resx:ResUI.ConnectionNeedAdmin}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Button
                                    x:Name="btnRebootAdmin"
                                    Margin="0,8,0,0"
                                    HorizontalAlignment="Left"
                                    Content="{x:Static resx:ResUI.menuRebootAsAdmin}"
                                    Style="{StaticResource DefButton}" />
                            </StackPanel>
                        </Border>

                        <CheckBox
                            x:Name="chkAutoGameConnect"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Content="{x:Static resx:ResUI.ManualGameTriggerLabel}"
                            Style="{StaticResource ListItemCheckBox}" />

                        <Border
                            x:Name="pnlTriggerPending"
                            Margin="0,10,0,0"
                            Padding="10,8"
                            Background="#1A1565C0"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Foreground="#FF64B5F6"
                                    Kind="GamepadVariant" />
                                <TextBlock
                                    x:Name="txtTriggerPending"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FF64B5F6"
                                    Style="{StaticResource ListItemSubTitle2}"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="btnCancelTrigger"
                                    Margin="16,0,0,0"
                                    VerticalAlignment="Center"
                                    Content="{x:Static resx:ResUI.TbCancel}"
                                    Style="{StaticResource DefButton}" />
                            </StackPanel>
                        </Border>

                        <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                            <Button
                                x:Name="btnApply"
                                MinWidth="140"
                                Content="{x:Static resx:ResUI.ConnectionApply}"
                                Style="{StaticResource GradientButton}" />
                            <TextBlock
                                x:Name="txtStatus"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Style="{StaticResource ToolbarTextBlock}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- ============ MANUAL CONNECTION LIST ============ -->
                <Border
                    x:Name="pnlManualList"
                    AllowDrop="True"
                    DragLeave="ManualList_DragLeave"
                    DragOver="ManualList_DragOver"
                    Drop="ManualList_Drop"
                    Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GpnCyan}"
                                        Kind="LanConnect" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="{x:Static resx:ResUI.ConnectionManualListTitle}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHint}" Text="{x:Static resx:ResUI.ConnectionManualListHint}" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="btnRefreshApps" Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Refresh" />
                                        <TextBlock Text="{x:Static resx:ResUI.SplitTunnelRefresh}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="btnAddApp"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock Text="{x:Static resx:ResUI.ManualAddApp}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="btnAddDomain"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Web" />
                                        <TextBlock Text="{x:Static resx:ResUI.ManualAddDomain}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="btnImportClipboard"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="ClipboardText" />
                                        <TextBlock Text="{x:Static resx:ResUI.ManualImportClipboard}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="btnEditApp"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Pencil" />
                                        <TextBlock Text="{x:Static resx:ResUI.ManualEdit}" />
                                    </StackPanel>
                                </Button>
                                <Button
                                    x:Name="btnRemoveApp"
                                    Margin="8,0,0,0"
                                    Style="{StaticResource DefButton}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Delete" />
                                        <TextBlock Text="{x:Static resx:ResUI.ManualRemove}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="pnlTunWarning"
                            Margin="0,0,0,8"
                            Padding="10,8"
                            Background="#3D3326"
                            CornerRadius="10"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Foreground="#FFFB8C00"
                                    Kind="AlertCircle" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FFFB8C00"
                                    Style="{StaticResource ListItemSubTitle2}"
                                    Text="{x:Static resx:ResUI.ManualTunSummary}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Border
                            x:Name="pnlDropHint"
                            Margin="0,0,0,8"
                            Padding="10,8"
                            Background="#1A1565C0"
                            BorderBrush="#FF1565C0"
                            BorderThickness="1"
                            CornerRadius="10"
                            DockPanel.Dock="Top"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    VerticalAlignment="Center"
                                    Foreground="#FF64B5F6"
                                    Kind="Download" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="#FF64B5F6"
                                    Style="{StaticResource ListItemSubTitle2}"
                                    Text="{x:Static resx:ResUI.ManualDropHint}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <StackPanel
                            Margin="0,0,0,8"
                            DockPanel.Dock="Top"
                            Orientation="Horizontal">
                            <TextBox
                                x:Name="txtManualFilter"
                                Width="240"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Hint="{x:Static resx:ResUI.ManualFilterHint}"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                Style="{StaticResource DefTextBox}" />
                            <TextBox
                                x:Name="txtDomain"
                                Width="260"
                                Margin="10,0,0,0"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Hint="{x:Static resx:ResUI.ManualDomainPlaceholder}"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                Style="{StaticResource DefTextBox}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="txtActiveRoutingRemarks"
                            Margin="0,0,0,6"
                            DockPanel.Dock="Bottom"
                            Opacity="0.6"
                            Style="{StaticResource ListItemSubTitle2}"
                            Text="{Binding ActiveRoutingRemarks}" />

                        <DataGrid
                            x:Name="lstApps"
                            MinHeight="150"
                            MaxHeight="300"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserResizeRows="False"
                            GridLinesVisibility="All"
                            HeadersVisibility="Column"
                            SelectionMode="Single"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="90"
                                    Binding="{Binding TypeText}"
                                    Header="{x:Static resx:ResUI.ManualColType}" />
                                <DataGridTemplateColumn Width="*" Header="{x:Static resx:ResUI.SplitTunnelColApp}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,1" Orientation="Horizontal">
                                                <Image
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    Width="180"
                                    Binding="{Binding ValueText}"
                                    Header="{x:Static resx:ResUI.ManualColValue}" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding DownloadText}"
                                    Header="{x:Static resx:ResUI.TbSortingDownTraffic}" />
                                <DataGridTextColumn
                                    Width="100"
                                    Binding="{Binding UploadText}"
                                    Header="{x:Static resx:ResUI.TbSortingUpTraffic}" />
                                <DataGridTemplateColumn
                                    Width="120"
                                    Header="{x:Static resx:ResUI.ManualColStatus}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,1" Orientation="Horizontal">
                                                <Ellipse
                                                    Width="9"
                                                    Height="9"
                                                    VerticalAlignment="Center">
                                                    <Ellipse.Style>
                                                        <Style TargetType="Ellipse">
                                                            <Setter Property="Fill" Value="#FF9E9E9E" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsRunning}" Value="True">
                                                                    <Setter Property="Fill" Value="#FF34D399" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Ellipse.Style>
                                                </Ellipse>
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{Binding RunStatusText}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="130"
                                    Header="{x:Static resx:ResUI.ManualColLive}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LiveRouteBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="76"
                                    Header="{x:Static resx:ResUI.ManualColWarn}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,1" HorizontalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Foreground="#FFF44336"
                                                    Kind="FileRemoveOutline"
                                                    ToolTip="{x:Static resx:ResUI.ManualExeMissing}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding ExeMissing}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="4,0,0,0"
                                                    Foreground="#FFFB8C00"
                                                    Kind="AlertCircle"
                                                    ToolTip="{x:Static resx:ResUI.ManualTunNeeded}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding NeedsTun}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="185"
                                    Header="{x:Static resx:ResUI.ConnectionCurrentRoute}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal">
                                                <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RouteBadgeTemplate}" />
                                                <Border
                                                    Margin="2,2"
                                                    Padding="6,1"
                                                    Background="#FFFB8C00"
                                                    CornerRadius="8"
                                                    ToolTip="{x:Static resx:ResUI.ManualSuggestedTooltip}">
                                                    <Border.Style>
                                                        <Style TargetType="Border">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsSuggested}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Border.Style>
                                                    <TextBlock
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        Foreground="White"
                                                        Text="{x:Static resx:ResUI.ManualSuggestedBadge}" />
                                                </Border>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridComboBoxColumn
                                    x:Name="colAction"
                                    Width="150"
                                    DisplayMemberPath="Text"
                                    Header="{x:Static resx:ResUI.ManualColAction}"
                                    SelectedValueBinding="{Binding Action, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    SelectedValuePath="ID" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

                <!-- ============ LIVE MONITORING ============ -->
                <Border Style="{StaticResource SectionCard}">
                    <DockPanel>
                        <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="20"
                                        Height="20"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{StaticResource GpnMagenta}"
                                        Kind="ChartTimelineVariant" />
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        Style="{StaticResource SectionTitle}"
                                        Text="{x:Static resx:ResUI.ConnectionLiveTitle}" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SectionHint}" Text="{x:Static resx:ResUI.MonitorHint}" />
                            </StackPanel>
                            <Border
                                Grid.Column="1"
                                MinWidth="104"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                Background="{StaticResource GpnCyanSoft}"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.7" Text="{x:Static resx:ResUI.MonitorConnectionsTab}" />
                                    <TextBlock FontSize="{DynamicResource StdFontSize9}" FontWeight="SemiBold" Foreground="{StaticResource GpnCyan}" Text="{Binding Monitor.ActiveConnectionCount}" />
                                </StackPanel>
                            </Border>
                            <Border
                                Grid.Column="2"
                                MinWidth="104"
                                Margin="10,0,0,0"
                                Padding="10,4"
                                Background="{StaticResource GpnVioletSoft}"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.7" Text="{x:Static resx:ResUI.MonitorAppsTab}" />
                                    <TextBlock FontSize="{DynamicResource StdFontSize9}" FontWeight="SemiBold" Foreground="{StaticResource GpnViolet}" Text="{Binding Monitor.ActiveAppCount}" />
                                </StackPanel>
                            </Border>
                            <StackPanel Grid.Column="3" Margin="10,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
                                <TextBlock VerticalAlignment="Center" Text="↓ " />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Monitor.TotalDownloadText}" />
                                <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" Text="↑ " />
                                <TextBlock VerticalAlignment="Center" Text="{Binding Monitor.TotalUploadText}" />
                            </StackPanel>
                        </Grid>

                        <WrapPanel Margin="0,0,0,6" DockPanel.Dock="Top">
                            <TextBox
                                x:Name="txtFilter"
                                Width="220"
                                MinWidth="160"
                                MaxWidth="320"
                                Margin="0,0,8,6"
                                VerticalContentAlignment="Center"
                                materialDesign:HintAssist.Hint="{x:Static resx:ResUI.MonitorFilterHint}"
                                materialDesign:TextFieldAssist.HasClearButton="True"
                                Style="{StaticResource DefTextBox}" />
                            <Button
                                x:Name="btnRefreshMonitor"
                                Width="24"
                                Height="24"
                                Margin="6,0,8,6"
                                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                                ToolTip="{x:Static resx:ResUI.SplitTunnelRefresh}">
                                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Refresh" />
                            </Button>
                            <CheckBox
                                x:Name="chkHideListeners"
                                Margin="6,0,8,6"
                                VerticalAlignment="Center"
                                Content="{x:Static resx:ResUI.MonitorHideListeners}"
                                Style="{StaticResource ListItemCheckBox}" />
                            <StackPanel
                                Margin="6,0,8,6"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.TbAutoRefresh}" />
                                <ToggleButton x:Name="togAutoRefresh" VerticalAlignment="Center" />
                            </StackPanel>
                        </WrapPanel>

                        <DataGrid
                            x:Name="lstConnections"
                            MinHeight="200"
                            MaxHeight="360"
                            AutoGenerateColumns="False"
                            BorderThickness="0"
                            HorizontalScrollBarVisibility="Disabled"
                            CanUserAddRows="False"
                            CanUserResizeRows="False"
                            EnableRowVirtualization="True"
                            GridLinesVisibility="None"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            SelectionMode="Single"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.ContextMenu>
                                <ContextMenu Style="{StaticResource DefContextMenu}">
                                    <MenuItem x:Name="menuCopyAddress" Header="{x:Static resx:ResUI.MonitorCopyAddress}" />
                                    <Separator />
                                    <MenuItem x:Name="menuAddToManual" Header="{x:Static resx:ResUI.MonitorAddToManual}" />
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2*" Header="{x:Static resx:ResUI.SplitTunnelColApp}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,2" Orientation="Horizontal">
                                                <Image Width="16" Height="16" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" />
                                                <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.55" Text="{Binding ProcessName}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn Width="1.1*" Header="{x:Static resx:ResUI.MonitorColRoute}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ContentControl Content="{Binding}" ContentTemplate="{StaticResource RouteBadgeTemplate}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="1.1*" Binding="{Binding Protocol}" Header="{x:Static resx:ResUI.MonitorColProtocol}" />
                                <DataGridTextColumn Width="1.6*" Binding="{Binding RemoteAddress}" Header="{x:Static resx:ResUI.MonitorColRemote}" />
                                <DataGridTemplateColumn Width="1.0*" Header="{x:Static resx:ResUI.MonitorColCountry}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="3,2" Orientation="Horizontal" ToolTip="{Binding CountryName}">
                                                <TextBlock Text="{Binding CountryText}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="1.6*" Binding="{Binding AsnText}" Header="{x:Static resx:ResUI.MonitorColAsn}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding State}" Header="{x:Static resx:ResUI.MonitorColState}" />
                                <DataGridTextColumn Width="0.8*" Binding="{Binding Pid}" Header="PID" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</reactiveui:ReactiveUserControl>
