<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<AssemblyName>AoGPN</AssemblyName>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<GenerateSatelliteAssembliesForCore>true</GenerateSatelliteAssembliesForCore>
		<UseWPF>true</UseWPF>
		<ApplicationIcon>Resources\AoGPN.ico</ApplicationIcon>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
		<SupportedOSPlatformVersion>7.0</SupportedOSPlatformVersion>
		<AllowUnsafeBlocks>true</AllowUnsafeBlocks>
		<CETCompat>false</CETCompat>
		<!-- Uygulamanın GERÇEKTEN sunduğu diller dışındaki uydu (satellite) derlemelerini
		     çıktıya kopyalama (TaskScheduler vb. paketlerin de/es/it/ja/pl/sv/zh-CN gibi
		     dilleri — çıktıda dolu dil klasörleri bırakırdı). Liste Dil/*.json ve
		     ServiceLib Resx kültürleriyle birebir aynıdır. -->
		<SatelliteResourceLanguages>fa;fr;hu;id;ru;tr;zh-Hans;zh-Hant</SatelliteResourceLanguages>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="MaterialDesignThemes" />
		<PackageReference Include="Microsoft.Web.WebView2" />
		<PackageReference Include="H.NotifyIcon.Wpf" />
		<PackageReference Include="ReactiveUI.Fody">
			<TreatAsUsed>true</TreatAsUsed>
		</PackageReference>
		<PackageReference Include="ReactiveUI.WPF" />
	</ItemGroup>

	<ItemGroup>
		<!-- The dashboard is kept at the repository path requested by the product and is
		     emitted as index.html beside the executable at build and publish time. -->
		<Content Include="..\vpn-gpn-dashboard.html" Link="index.html">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<!-- The dashboard's stylesheet (dashboard.css), application script (app.js),
		     theme definitions (themes.json) and UI strings (Dil/*.json) ship beside
		     the document so styles, logic, themes and translations can be edited
		     without touching the HTML itself. -->
		<!--
		  YALNIZCA çalışma zamanı dosyaları paketlenir. Temalar/ altındaki
		  geliştirme artıkları (node_modules, __pycache__/*.pyc, test koşum
		  dosyaları, *.test.js, döküm/çeviri betikleri, npm manifestoları) yayın
		  paketine girmez: uygulama bunların hiçbirini okumaz, ama kullanıcıya
		  giden zip'i onlarca megabayt şişirirler.

		  Hangi dosyanın gerçekten çalışma zamanında gerektiği bu glob ile
		  tahmin edilmez; kaynağı bellidir: index.html ve skins/*/skin.html
		  içindeki <script>/<link> etiketleri, skins.json ve themes.json. Bu
		  yüzden Temalar/tailwind.js (index.html <script>) ile
		  Temalar/skins/route-keys.js (üç skin.html de <script> ile yükler)
		  buradadır ve HARİÇ TUTULMAZ — ekran görüntüsü/sandbox yardımcıları
		  (skin-sandbox.js, skin-pairs.js, cascade-consistency.js) ise yalnızca
		  *.test.js dosyalarından require edildiği için pakete girmez.

		  Kara liste bilerek seçildi: yeni bir çalışma zamanı dosyası eklenince
		  kendiliğinden pakete girer; beyaz liste olsaydı yeni skin/asset sessizce
		  eksik kalırdı. Kaçak oluşursa 'Verify package contents' adımı yakalar.
		-->
		<Content Include="..\Temalar\**"
		         Exclude="..\Temalar\**\node_modules\**;
		                  ..\Temalar\**\__pycache__\**;
		                  ..\Temalar\**\*.pyc;
		                  ..\Temalar\**\*.test.js;
		                  ..\Temalar\skins\_*;
		                  ..\Temalar\skins\package.json;
		                  ..\Temalar\skins\package-lock.json;
		                  ..\Temalar\skins\skin-sandbox.js;
		                  ..\Temalar\skins\skin-pairs.js;
		                  ..\Temalar\skins\cascade-consistency.js;
		                  ..\Temalar\split-*.js;
		                  ..\Temalar\build-embedded-dashboard-css.js;
		                  ..\Temalar\fetch-google-fonts.js"
		         Link="Temalar\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="..\Dil\**" Link="Dil\%(RecursiveDir)%(Filename)%(Extension)">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>

		<AdditionalFiles Include="app.manifest" />
		<EmbeddedResource Include="Resources\AoGPN.ico">
			<CopyToOutputDirectory>Never</CopyToOutputDirectory>
		</EmbeddedResource>
		<Resource Include="Resources\Splash.png" />
		<Resource Include="Resources\NotifyIcon1.ico" />
		<Resource Include="Resources\NotifyIcon2.ico" />
		<Resource Include="Resources\NotifyIcon3.ico" />
		<Resource Include="Resources\NotifyIcon4.ico" />
		<Resource Include="Resources\AoGPN.ico" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ServiceLib\ServiceLib.csproj" />
		<!--
		  Yan güncelleyici (AoGPN.Updater.exe): ayrı bir YÜRÜTÜLEBİLİR dosya olarak
		  AoGPN.exe'nin yanında dağıtılır. Ayrı süreç olması zorunludur — güncelleme
		  sırasında AoGPN.exe ve bağımlılıkları kilitliyken kendi dosyalarının
		  üzerine yazabilmesi gerekir. Ana derlemeye DERLEME bağımlılığı yoktur
		  (ReferenceOutputAssembly=false): yalnızca yan yana durur; bu yüzden bir
		  güncelleme paketi ana uygulamayı da bozsa güncelleyici yine çalışır.
		-->
		<ProjectReference Include="..\AoGPN.Updater\AoGPN.Updater.csproj">
			<ReferenceOutputAssembly>false</ReferenceOutputAssembly>
			<Private>false</Private>
		</ProjectReference>
	</ItemGroup>

	<!--
	  Güncelleyici çıktısını AoGPN'nin çıktı klasörüne kopyalar. Güncelleyici
	  WPF'siz olduğu için TFM'i net10.0'dır (ana uygulama net10.0-windows…); bu
	  yüzden önce sabit net10.0 klasörü, bulunamazsa ana projenin TFM'i denenir.
	  Framework'e bağımlı derlemede exe + .dll + .deps.json + .runtimeconfig.json
	  gerekir; tek dosya (publish) yayınında yalnızca exe bulunur — hepsi
	  "varsa kopyala" mantığıyla işlenir. Kopyalama başarısız olsa da derleme
	  bozulmaz (uygulama çalışır; güncelleme özelliği devre dışı kalır ve
	  UpdateAvailableWindow bunu kullanıcıya hiç göstermez).
	-->
	<Target Name="CopyUpdaterToOutput"
	        AfterTargets="Build;Publish"
	        Condition="!$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_UpdaterBaseDir>$(MSBuildProjectDirectory)\..\AoGPN.Updater\bin\$(Configuration)\</_UpdaterBaseDir>
			<!-- RID'e özgü derlemede/yayında (dotnet publish -r win-x64) çıktı net10.0\<rid>\ altına düşer. -->
			<_UpdaterOutDir Condition="'$(RuntimeIdentifier)' != '' AND Exists('$(_UpdaterBaseDir)net10.0\$(RuntimeIdentifier)\AoGPN.Updater.exe')">$(_UpdaterBaseDir)net10.0\$(RuntimeIdentifier)\</_UpdaterOutDir>
			<_UpdaterOutDir Condition="'$(_UpdaterOutDir)' == '' AND Exists('$(_UpdaterBaseDir)net10.0\AoGPN.Updater.exe')">$(_UpdaterBaseDir)net10.0\</_UpdaterOutDir>
			<_UpdaterOutDir Condition="'$(_UpdaterOutDir)' == ''">$(_UpdaterBaseDir)$(TargetFramework)\</_UpdaterOutDir>
		</PropertyGroup>
		<ItemGroup>
			<_UpdaterFiles Include="$(_UpdaterOutDir)AoGPN.Updater.exe" Condition="Exists('$(_UpdaterOutDir)AoGPN.Updater.exe')" />
			<_UpdaterFiles Include="$(_UpdaterOutDir)AoGPN.Updater.dll" Condition="Exists('$(_UpdaterOutDir)AoGPN.Updater.dll')" />
			<_UpdaterFiles Include="$(_UpdaterOutDir)AoGPN.Updater.deps.json" Condition="Exists('$(_UpdaterOutDir)AoGPN.Updater.deps.json')" />
			<_UpdaterFiles Include="$(_UpdaterOutDir)AoGPN.Updater.runtimeconfig.json" Condition="Exists('$(_UpdaterOutDir)AoGPN.Updater.runtimeconfig.json')" />
		</ItemGroup>
		<Copy SourceFiles="@(_UpdaterFiles)"
		      DestinationFolder="$(OutDir)"
		      SkipUnchangedFiles="true"
		      ContinueOnError="ErrorAndContinue" />
		<!--
		  Yayın (publish) çıktısı çoğu zaman ayrı bir klasördür; paketleme betiği
		  yayını sıkıştırıyorsa güncelleyici orada da bulunmalıdır — aksi halde
		  kullanıcıya "yeni sürüm var" denip güncelleme uygulanamaz.
		-->
		<Copy SourceFiles="@(_UpdaterFiles)"
		      DestinationFolder="$(PublishDir)"
		      SkipUnchangedFiles="true"
		      ContinueOnError="ErrorAndContinue"
		      Condition="'$(PublishDir)' != ''" />
		<Warning Condition="!Exists('$(OutDir)AoGPN.Updater.exe')"
		         Text="AoGPN.Updater.exe could not be copied to '$(OutDir)'. The in-app updater stays disabled until the AoGPN.Updater project builds and its output is available at '$(_UpdaterOutDir)'." />
	</Target>

	<!--
	  The dashboard ships as a single offline HTML whose <style
	  id="embedded-dashboard-css"> block is a concatenated copy of the split
	  stylesheet chain (Temalar/dashboard.css imports base.css, components.css,
	  the theme files and effects.css, in that order). That embedded copy must never drift from
	  the source files, so it is regenerated here from the manifest before every
	  build — never edited by hand. The generator is idempotent (writes only
	  when the concatenation actually differs) and supports a check mode that
	  DashboardAssetTests uses to fail a stale copy. A machine without node does
	  not break the build; it gets a warning and the test suite (which runs on CI
	  with node) still enforces sync. Requires node on PATH. -->
	<Target Name="RegenerateEmbeddedDashboardCss"
	        BeforeTargets="BeforeBuild"
	        Condition="!$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<Exec Command="node &quot;$(MSBuildProjectDirectory)\..\Temalar\build-embedded-dashboard-css.js&quot;"
		      WorkingDirectory="$(MSBuildProjectDirectory)\.."
		      IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_EmbeddedCssExitCode" />
		</Exec>
		<Warning Condition="'$(_EmbeddedCssExitCode)' != '0'"
		         Text="Could not regenerate the embedded dashboard CSS (node missing or the script failed; exit $(_EmbeddedCssExitCode)). The offline copy may be stale — run &quot;node Temalar\build-embedded-dashboard-css.js&quot; manually. DashboardAssetTests verifies sync on CI." />
	</Target>


	<!--
	  Dev convenience: the core runtimes (mihomo, xray, wintun, geo files) are
	  downloaded/kept in the Release output's bin folder and never land in a fresh
	  Debug output, so F5 debugging could not start any tunnel. Copy them from the
	  Release output into the current output so every build leaves the cores ready.
	  SkipUnchangedFiles keeps incremental builds cheap; a missing Release bin only
	  produces a warning (build once with -c Release, or use the app's update check).
	-->
	<Target Name="CopyCoreBinariesFromReleaseOutput"
	        AfterTargets="Build"
	        Condition="'$(Configuration)' == 'Debug' And !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_CoreSourceDir>$(MSBuildProjectDirectory)\bin\Release\$(TargetFramework)\bin\</_CoreSourceDir>
			<_CoreDestinationDir>$(OutDir)bin\</_CoreDestinationDir>
		</PropertyGroup>
		<ItemGroup>
			<_CoreFiles Include="$(_CoreSourceDir)**\*" />
		</ItemGroup>
		<Copy SourceFiles="@(_CoreFiles)"
		      DestinationFiles="@(_CoreFiles->'$(_CoreDestinationDir)%(RecursiveDir)%(Filename)%(Extension)')"
		      SkipUnchangedFiles="true"
		      Condition="Exists('$(_CoreSourceDir)')" />
		<Warning Condition="!Exists('$(_CoreSourceDir)')"
		         Text="Core binaries not found at '$(_CoreSourceDir)'. Build once with -c Release (or run the app's update check) so the Debug build can copy the mihomo/xray cores." />
	</Target>

	<!--
	  Fetches the mihomo/Xray cores into the Release output when they are missing.
	  Runs the freshly built executable in headless "update cores" mode, which
	  drives UpdateService's check/download pipeline and unpacks the archives next
	  to the executable. A failed download (e.g. offline) does not fail the build;
	  the next build simply retries. Debug builds then get the cores via the copy
	  target above.
	-->
	<Target Name="DownloadCoreBinariesIntoReleaseOutput"
	        AfterTargets="Build"
	        Condition="'$(Configuration)' == 'Release' And !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_ReleaseBinDir>$(OutDir)bin\</_ReleaseBinDir>
			<!-- TargetPath resolves to the assembly (AoGPN.dll); the apphost exe is
			     the one that must be launched for headless core installation. -->
			<_ReleaseExe>$(TargetDir)$(AssemblyName).exe</_ReleaseExe>
			<_CoresMissing Condition="!Exists('$(_ReleaseBinDir)xray\xray.exe') Or (!Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64-v1.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64-compatible.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-arm64.exe'))">true</_CoresMissing>
		</PropertyGroup>
		<Exec Condition="'$(_CoresMissing)' == 'true' And Exists('$(_ReleaseExe)')"
		      Command="&quot;$(_ReleaseExe)&quot; --update-cores"
		      WorkingDirectory="$(OutDir)"
		      IgnoreExitCode="true" />
		<!-- Re-check existence after the Exec so the warning only appears when the
		     download really did not leave runnable cores behind. -->        <Warning Condition="'$(_CoresMissing)' == 'true' And (!Exists('$(_ReleaseBinDir)xray\xray.exe') Or (!Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64-v1.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64-compatible.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-amd64.exe') And !Exists('$(_ReleaseBinDir)mihomo\mihomo-windows-arm64.exe')))"
                 Text="Core binaries are missing from '$(_ReleaseBinDir)' and the download did not complete. The build continues; run &quot;AoGPN.exe --update-cores&quot; manually or build again when online." />
	</Target>

	<!--
	  Dev convenience for a fresh Debug F5 direct from source. Debug normally copies
	  the cores from the Release output (CopyCoreBinariesFromReleaseOutput); on a
	  machine with no prior -c Release build that copy finds nothing, so no core can
	  ever start and the GPN bridge reports "wintun.dll bulunamadı". Mirror the
	  Release target: when mihomo/xray are still missing AFTER the Release-output
	  copy, run the freshly built executable in headless "update cores" mode, which
	  drives CoreInstaller's UpdateService download/unpack pipeline (and promotes or
	  downloads wintun.dll next to the executable). A failed/offline download does
	  not fail the build; the next build simply retries.
	-->
	<Target Name="DownloadCoreBinariesIntoDebugOutput"
	        AfterTargets="Build;CopyCoreBinariesFromReleaseOutput"
	        Condition="'$(Configuration)' == 'Debug' And !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_DebugBinDir>$(OutDir)bin\</_DebugBinDir>
			<_DebugExe>$(TargetDir)$(AssemblyName).exe</_DebugExe>
			<_DebugCoresMissing Condition="!Exists('$(_DebugBinDir)xray\xray.exe') Or (!Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64-v1.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64-compatible.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-arm64.exe'))">true</_DebugCoresMissing>
		</PropertyGroup>
		<Exec Condition="'$(_DebugCoresMissing)' == 'true' And Exists('$(_DebugExe)')"
		      Command="&quot;$(_DebugExe)&quot; --update-cores"
		      WorkingDirectory="$(OutDir)"
		      IgnoreExitCode="true" />
		<!-- Re-check existence after the Exec so the warning only appears when the
		     download really did not leave runnable cores behind. -->
		<Warning Condition="'$(_DebugCoresMissing)' == 'true' And (!Exists('$(_DebugBinDir)xray\xray.exe') Or (!Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64-v1.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64-compatible.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-amd64.exe') And !Exists('$(_DebugBinDir)mihomo\mihomo-windows-arm64.exe')))"
		         Text="Core binaries are missing from '$(_DebugBinDir)' and the download did not complete. The build continues; run &quot;AoGPN.exe --update-cores&quot; manually or build again when online." />
	</Target>


	<!--
	  Ensures wintun.dll sits next to the executable. The GPN capture bridge
	  (WintunNative P/Invoke) loads "wintun.dll" from the application directory
	  using the default DLL search order, so a copy buried under bin\xray\ or
	  bin\mihomo\ is never found and the bridge reports "wintun.dll bulunamadı".
	  The Xray release archive ships wintun.dll inside its own folder; promote it
	  (or the mihomo copy) to $(OutDir) after the cores have been copied or
	  downloaded. If neither core provides one, the build still succeeds and
	  CoreInstaller's update-cores mode (or the packaged release) fetches it from
	  the official Wintun distribution instead.

	  IMPORTANT: the app needs a wintun.dll that exports WintunGetAdapterLUID
	  (added in wintun 0.14.1) — the GPN capture bridge calls it on every adapter
	  open (WireGuardTunnelService). Older xray/mihomo bundles ship a wintun.dll
	  WITHOUT that export; blindly promoting it makes the bridge fail with
	  "Unable to find an entry point named 'WintunGetAdapterLUID' in DLL
	  'wintun.dll'" and every GPN session silently runs capture-bridge=skipped.
	  (Export lookup is case-sensitive; the official name is all-caps LUID.)
	  So the candidate's export table is checked first (ASCII symbol scan,
	  deterministic vs findstr on binary PE data); a stale candidate is discarded
	  and the official wintun-0.14.1 amd64 build is downloaded into
	  $(IntermediateOutputPath) instead (same source the CI wintun-driver-smoke
	  job uses). An already-promoted copy that lacks the export is also replaced.
	-->
	<Target Name="PromoteWintunDllToOutputRoot"
	        AfterTargets="CopyCoreBinariesFromReleaseOutput;DownloadCoreBinariesIntoReleaseOutput;DownloadCoreBinariesIntoDebugOutput"
	        Condition="'$(OS)' == 'Windows_NT' And !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_WintunSource Condition="Exists('$(OutDir)bin\xray\wintun.dll')">$(OutDir)bin\xray\wintun.dll</_WintunSource>
			<_WintunSource Condition="'$(_WintunSource)' == '' And Exists('$(OutDir)bin\mihomo\wintun.dll')">$(OutDir)bin\mihomo\wintun.dll</_WintunSource>
			<_WintunCandidateExportsLuid>false</_WintunCandidateExportsLuid>
		</PropertyGroup>
		<!-- Pick a candidate that actually exports WintunGetAdapterLUID (exit 0 = found). -->
		<Exec Condition="'$(_WintunSource)' != ''"
		      Command="powershell -NoProfile -Command &quot;$s='$(_WintunSource)'; try { $b=[IO.File]::ReadAllBytes($s); $t=[Text.Encoding]::ASCII.GetString($b); if ($t.Contains('WintunGetAdapterLUID')) { exit 0 } } catch {}; exit 1&quot;"
		      IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_WintunCandidateCheck" />
		</Exec>
		<PropertyGroup>
			<_WintunCandidateExportsLuid Condition="'$(_WintunCandidateCheck)' == '0'">true</_WintunCandidateExportsLuid>
		</PropertyGroup>
		<!-- Stale candidate (or no candidate): fetch official wintun 0.14.1 amd64 build. -->
		<PropertyGroup>
			<_WintunFetchDir>$(IntermediateOutputPath)wintun-fetch</_WintunFetchDir>
			<_WintunFetchZip>$(_WintunFetchDir)\wintun-0.14.1.zip</_WintunFetchZip>
			<_WintunOfficialDll>$(_WintunFetchDir)\wintun\bin\amd64\wintun.dll</_WintunOfficialDll>
		</PropertyGroup>
		<Exec Condition="'$(_WintunCandidateExportsLuid)' != 'true' And !Exists('$(_WintunOfficialDll)')"
		      Command="powershell -NoProfile -Command &quot;$d='$(_WintunFetchDir)'; $z='$(_WintunFetchZip)'; try { New-Item -ItemType Directory -Force -Path $d | Out-Null; Invoke-WebRequest -UseBasicParsing -Uri 'https://www.wintun.net/builds/wintun-0.14.1.zip' -OutFile $z; Expand-Archive -Path $z -DestinationPath $d -Force; exit 0 } catch { exit 2 }&quot;"
		      IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_WintunFetchExit" />
		</Exec>
		<PropertyGroup>
			<_WintunFinalSource Condition="'$(_WintunCandidateExportsLuid)' == 'true'">$(_WintunSource)</_WintunFinalSource>
			<_WintunFinalSource Condition="'$(_WintunCandidateExportsLuid)' != 'true' And Exists('$(_WintunOfficialDll)')">$(_WintunOfficialDll)</_WintunFinalSource>
		</PropertyGroup>
		<!-- Copy (overwrites a stale promoted copy; SkipUnchangedFiles keeps a
		     good copy untouched). ContinueOnError: the app may be running and hold
		     wintun.dll locked (normal Windows loader behaviour) — a locked target
		     must not fail the build; the next build after closing the app fixes it,
		     and the bridge itself reports the stale DLL in gpn-session.log. -->
		<Copy SourceFiles="$(_WintunFinalSource)"
		      DestinationFiles="$(OutDir)wintun.dll"
		      SkipUnchangedFiles="true"
		      Retries="0"
		      ContinueOnError="ErrorAndContinue"
		      Condition="'$(_WintunFinalSource)' != '' And Exists('$(_WintunFinalSource)')" />
		<!-- Keep diagnostics explicit: a missing/stale wintun.dll must never
		     silently disable the GPN capture bridge after a clean build. -->
		<Warning Condition="!Exists('$(OutDir)wintun.dll') Or ('$(_WintunCandidateExportsLuid)' != 'true' And !Exists('$(_WintunOfficialDll)'))"
		         Text="wintun.dll is missing in the output or does not export WintunGetAdapterLUID (GPN capture bridge needs wintun 0.14.1+), and the official download failed. The bridge will be skipped until it is provided; run &quot;AoGPN.exe --update-cores&quot; (or a packaged release) to fetch it from the official Wintun distribution." />
	</Target>

	<!--
	  Ensures WinDivert.dll (+ its kernel driver WinDivert64.sys) sits next to
	  the executable. The GPN capture bridge (WinDivertNative P/Invoke) loads
	  "WinDivert.dll" from the application directory; nothing in the core bundles
	  (mihomo / xray / wintun) ships it, so a fresh output has always been dead:
	  "GPN_BRIDGE yakalama döngüsü fault: Unable to load DLL 'WinDivert.dll'".

	  Per the WinDivert documentation the driver is installed silently and on
	  demand by WinDivertOpen() from WinDivert64.sys sitting next to the DLL
	  (the process must be Administrator — the GPN TUN path already requires
	  elevation, so this holds in practice). Errors when anything is missing are
	  mapped to a clear message by WinDivertEngine (ERROR_FILE_NOT_FOUND / 5 / 577
	  / 1275 / 1753).

	  Source: official WinDivert 2.2.2 distribution (basil00/WinDivert,
	  LGPL-3.0 — the LICENSE ships next to the app as WinDivert-LICENSE.txt).
	  The distribution is VENDORED in the repository (Libs\WinDivert\
	  WinDivert-2.2.2-A.zip, see Libs\WinDivert\README.md for the SHA-256) so
	  builds work offline and deterministically; the zip is extracted ONCE into
	  $(IntermediateOutputPath) and the right architecture pair is copied:
	  x64 apps get x64\WinDivert.dll + WinDivert64.sys; RID/Platform 'x86'
	  builds additionally get WinDivert32.sys (a 32-bit app on 64-bit Windows
	  needs both drivers). If the vendored zip is missing, the build falls back
	  to downloading the official release (TLS 1.2 must be set explicitly —
	  Windows PowerShell 5.1 otherwise offers an older TLS and GitHub refuses).
	  A failed extraction/download does not fail the build (same convention as
	  the wintun target); the next build retries, and the engine reports the
	  missing files clearly.
	-->
	<Target Name="PromoteWinDivertToOutputRoot"
	        AfterTargets="CopyCoreBinariesFromReleaseOutput;DownloadCoreBinariesIntoReleaseOutput;DownloadCoreBinariesIntoDebugOutput"
	        Condition="'$(OS)' == 'Windows_NT' And !$(MSBuildProjectFile.EndsWith('_wpftmp.csproj'))">
		<PropertyGroup>
			<_WinDivertIsX86>false</_WinDivertIsX86>
			<_WinDivertIsX86 Condition="$(RuntimeIdentifier.StartsWith('win-x86')) Or '$(Platform)' == 'x86' Or '$(PlatformTarget)' == 'x86'">true</_WinDivertIsX86>
			<_WinDivertPresent>false</_WinDivertPresent>
		</PropertyGroup>
		<!-- Zaten dağıtılmışsa dokunma (yeniden indirme/açma yok); eksik dosyalar
		     varsa yeniden kopyalanır. -->
		<PropertyGroup>
			<_WinDivertPresent Condition="Exists('$(OutDir)WinDivert.dll') And Exists('$(OutDir)WinDivert64.sys') And ('$(_WinDivertIsX86)' != 'true' Or Exists('$(OutDir)WinDivert32.sys'))">true</_WinDivertPresent>
		</PropertyGroup>
		<PropertyGroup>
			<_WinDivertFetchDir>$(IntermediateOutputPath)windivert-fetch</_WinDivertFetchDir>
			<_WinDivertFetchZip>$(_WinDivertFetchDir)\WinDivert-2.2.2-A.zip</_WinDivertFetchZip>
			<_WinDivertExtractDir>$(_WinDivertFetchDir)\WinDivert-2.2.2-A</_WinDivertExtractDir>
		</PropertyGroup>
		<PropertyGroup>
			<_WinDivertVendoredZip Condition="Exists('$(MSBuildProjectDirectory)\..\Libs\WinDivert\WinDivert-2.2.2-A.zip')">$(MSBuildProjectDirectory)\..\Libs\WinDivert\WinDivert-2.2.2-A.zip</_WinDivertVendoredZip>
		</PropertyGroup>
		<!-- Preferred: extract the vendored official distribution (offline-safe). -->
		<Exec Condition="'$(_WinDivertPresent)' != 'true' And '$(_WinDivertVendoredZip)' != '' And !Exists('$(_WinDivertFetchZip)')"
		      Command="powershell -NoProfile -Command &quot;$d='$(_WinDivertFetchDir)'; try { New-Item -ItemType Directory -Force -Path $d | Out-Null; Copy-Item -LiteralPath '$(_WinDivertVendoredZip)' -Destination '$(_WinDivertFetchZip)' -Force; Expand-Archive -Path '$(_WinDivertFetchZip)' -DestinationPath $d -Force; exit 0 } catch { exit 3 }&quot;"
		      IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_WinDivertExtractExit" />
		</Exec>
		<!-- Fallback: official GitHub release download (TLS 1.2 set explicitly). -->
		<Exec Condition="'$(_WinDivertPresent)' != 'true' And '$(_WinDivertVendoredZip)' == '' And !Exists('$(_WinDivertFetchZip)')"
		      Command="powershell -NoProfile -Command &quot;$d='$(_WinDivertFetchDir)'; $z='$(_WinDivertFetchZip)'; try { New-Item -ItemType Directory -Force -Path $d | Out-Null; [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12; Invoke-WebRequest -UseBasicParsing -Uri 'https://github.com/basil00/WinDivert/releases/download/v2.2.2/WinDivert-2.2.2-A.zip' -OutFile $z; Expand-Archive -Path $z -DestinationPath $d -Force; exit 0 } catch { exit 2 }&quot;"
		      IgnoreExitCode="true">
			<Output TaskParameter="ExitCode" PropertyName="_WinDivertFetchExit" />
		</Exec>
		<ItemGroup Condition="'$(_WinDivertIsX86)' != 'true'">
			<_WinDivertToCopy Include="$(_WinDivertExtractDir)\x64\WinDivert.dll" />
			<_WinDivertToCopy Include="$(_WinDivertExtractDir)\x64\WinDivert64.sys" />
		</ItemGroup>
		<ItemGroup Condition="'$(_WinDivertIsX86)' == 'true'">
			<_WinDivertToCopy Include="$(_WinDivertExtractDir)\x86\WinDivert.dll" />
			<_WinDivertToCopy Include="$(_WinDivertExtractDir)\x86\WinDivert32.sys" />
			<_WinDivertToCopy Include="$(_WinDivertExtractDir)\x86\WinDivert64.sys" />
		</ItemGroup>
		<!-- Copy (ContinueOnError: the app may be running and hold the files
		     locked — locked targets must not fail the build; next build fixes it). -->
		<Copy SourceFiles="@(_WinDivertToCopy)"
		      DestinationFolder="$(OutDir)"
		      SkipUnchangedFiles="true"
		      ContinueOnError="ErrorAndContinue"
		      Condition="'$(_WinDivertPresent)' != 'true' And '@(_WinDivertToCopy)' != ''" />
		<ItemGroup Condition="'$(_WinDivertPresent)' != 'true'">
			<_WinDivertLicense Include="$(_WinDivertExtractDir)\LICENSE" />
		</ItemGroup>
		<Copy SourceFiles="@(_WinDivertLicense)"
		      DestinationFiles="$(OutDir)WinDivert-LICENSE.txt"
		      SkipUnchangedFiles="true"
		      ContinueOnError="ErrorAndContinue"
		      Condition="'@(_WinDivertLicense)' != '' And Exists('$(_WinDivertExtractDir)\LICENSE')" />
		<!-- Tanıyı açık tut: eksik WinDivert DLL'i köprüyü sessizce öldürmesin. -->
		<Warning Condition="'$(_WinDivertPresent)' != 'true' And (!Exists('$(OutDir)WinDivert.dll') Or !Exists('$(OutDir)WinDivert64.sys')) And (('$(_WinDivertFetchExit)' != '' And '$(_WinDivertFetchExit)' != '0') Or ('$(_WinDivertExtractExit)' != '' And '$(_WinDivertExtractExit)' != '0'))"
		         Text="WinDivert.dll / WinDivert64.sys are missing from '$(OutDir)' and the vendored Libs\WinDivert distribution could not be extracted (nor downloaded as fallback). The GPN capture bridge stays dead until they are provided; the next build retries." />
	</Target>

	<!--
	  Çıktıyı yalnızca Windows x64'ün gerçekten yüklediği yerel kitaplıklarla bırak:
	  SQLitePCLRaw / SkiaSharp / WebView2Loader, NuGet paketlerinde runtimes/ altında
	  android/ios/linux/mac/freebsd dahil ~40+ platform klasörü taşır ve hepsi her
	  derlemede çıktıya kopyalanır (~87 MB ölü dosya). Yalnızca win-x64/native
      (e_sqlite3 + WebView2Loader + libSkiaSharp) çalışma anında okunur — gerisi
      her derlemede temizlenir. Uygulama Windows x64'e özgüdür (WinDivert64.sys +
      wintun x64); win-arm64 gerektiren bir dağıtım zaten ayrı RID ile paketlenir.
	-->
	<Target Name="PruneCrossPlatformRuntimeAssets"
	        AfterTargets="Build;CopyCoreBinariesFromReleaseOutput;DownloadCoreBinariesIntoReleaseOutput;DownloadCoreBinariesIntoDebugOutput"
	        Condition="!$(MSBuildProjectFile.EndsWith('_wpftmp.csproj')) And Exists('$(OutDir)runtimes')">
		<ItemGroup>
			<_RuntimeRootDir Include="$([System.IO.Directory]::GetDirectories('$(OutDir)runtimes'))" />
		</ItemGroup>
		<ItemGroup>
			<_RuntimeToRemove Include="@(_RuntimeRootDir)" Exclude="$(OutDir)runtimes\win-x64" />
		</ItemGroup>
		<RemoveDir Directories="@(_RuntimeToRemove)" />
		<!-- runtimes klasörü yalnızca win-x64 kaldıysa onu da çıktı köküne "gömme" —
		     runtimes/win-x64/native düzeni .NET'in yerel kitaplık arama kuralıdır ve
		     korunmalıdır (klasörü kaldırma, İÇİNDEKİLERİ sakla). -->
	</Target>

</Project>
