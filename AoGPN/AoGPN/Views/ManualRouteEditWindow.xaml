<base:WindowBase
    x:Class="AoGPN.Views.ManualRouteEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:AoGPN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{x:Static resx:ResUI.ManualEditTitle}"
    Width="480"
    Height="380"
    x:TypeArguments="vms:ManualRouteEditViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <Grid Margin="{StaticResource Margin4}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Row="0"
                Grid.Column="0"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.ManualColType}" />
            <TextBlock
                x:Name="txtEntryType"
                Grid.Row="0"
                Grid.Column="1"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}" />

            <TextBlock
                Grid.Row="1"
                Grid.Column="0"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.ManualEditDisplayName}" />
            <TextBox
                x:Name="txtDisplayName"
                Grid.Row="1"
                Grid.Column="1"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource DefTextBox}" />

            <TextBlock
                Grid.Row="2"
                Grid.Column="0"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{Binding ValueLabel}" />
            <TextBox
                x:Name="txtValue"
                Grid.Row="2"
                Grid.Column="1"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource DefTextBox}" />

            <TextBlock
                Grid.Row="3"
                Grid.Column="0"
                Margin="{StaticResource Margin4}"
                VerticalAlignment="Center"
                Style="{StaticResource ToolbarTextBlock}"
                Text="{x:Static resx:ResUI.ManualColAction}" />
            <ComboBox
                x:Name="cmbAction"
                Grid.Row="3"
                Grid.Column="1"
                Margin="{StaticResource Margin4}"
                HorizontalAlignment="Left"
                MinWidth="200"
                DisplayMemberPath="Text"
                SelectedValuePath="ID"
                Style="{StaticResource DefComboBox}" />

            <TextBlock
                Grid.Row="4"
                Grid.Column="1"
                Margin="{StaticResource Margin4}"
                Opacity="0.6"
                Style="{StaticResource ListItemSubTitle2}"
                Text="{x:Static resx:ResUI.ConnectionManualListHint}"
                TextWrapping="Wrap" />
        </Grid>
    </DockPanel>
</base:WindowBase>
