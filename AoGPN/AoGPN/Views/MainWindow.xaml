<base:WindowBase
    x:Class="AoGPN.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:AoGPN.Base"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    xmlns:controls="clr-namespace:AoGPN.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:view="clr-namespace:AoGPN.Views"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="AO GPN"
    WindowStyle="None"
    Width="1200"
    Height="800"
    MinWidth="720"
    MinHeight="520"
    x:TypeArguments="vms:MainWindowViewModel"
    Icon="/Resources/AoGPN.ico"
    ResizeMode="CanResize"
    ShowInTaskbar="True"
    Background="#FF0B0F19"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <!--
        The borderless look is kept via WindowStyle="None" + the native thick frame
        style restored in OnSourceInitialized. The system frame is invisible but
        provides real resize borders and maximized-to-work-area behavior, which
        works even though WebView2 covers the entire client area.
    -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesignTheme.Popupbox.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <BooleanToVisibilityConverter x:Key="BoolToVisConverter" />

            <!-- AoGPN design sidebar: active nav gets a gradient wash + accent bar -->
            <LinearGradientBrush x:Key="NavActiveBg" StartPoint="0,0" EndPoint="1,0">
                <GradientStop Offset="0" Color="#297C4DFF" />
                <GradientStop Offset="1" Color="#0D00B8D4" />
            </LinearGradientBrush>
            <Style x:Key="SidebarNavButton" TargetType="{x:Type Button}">
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="Height" Value="42" />
                <Setter Property="Margin" Value="0,2" />
                <Setter Property="Padding" Value="14,0" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border
                                x:Name="Bd"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="10">
                                <Grid>
                                    <Border
                                        x:Name="Bar"
                                        Width="3"
                                        Height="0"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Center"
                                        Background="{StaticResource NavActiveBrush}"
                                        CornerRadius="99"
                                        Visibility="Collapsed">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="6"
                                                Color="#7C4DFF"
                                                Opacity="0.9"
                                                ShadowDepth="0" />
                                        </Border.Effect>
                                    </Border>
                                    <ContentPresenter
                                        Margin="{TemplateBinding Padding}"
                                        VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#0DFFFFFF" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="#1A7C4DFF" />
                                </Trigger>
                                <DataTrigger
                                    Binding="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(controls:NavState.IsActive)}"
                                    Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{StaticResource NavActiveBg}" />
                                    <Setter TargetName="Bd" Property="BorderBrush" Value="#557C4DFF" />
                                    <Setter TargetName="Bar" Property="Height" Value="24" />
                                    <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                                    <Setter Property="Foreground" Value="#22D3EE" />
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Window.Resources>

    <Grid>
        <!--
            WebView2 is a native child HWND. An entirely transparent layered WPF window
            does not contribute hit-testable pixels for that child, so mouse clicks can
            fall through to the window underneath. Keep the requested transparent window
            chrome while providing an opaque backing surface for reliable input capture.
        -->
        <Border
            Panel.ZIndex="0"
            Background="#FF0B0F17"
            IsHitTestVisible="False" />

        <!-- The legacy WPF surface remains instantiated for the existing application
             services, but the visible product UI is rendered entirely by WebView2. -->
        <materialDesign:DialogHost
            Visibility="Collapsed"
            materialDesign:TransitionAssist.DisableTransitions="True"
        CloseOnClickAway="True"
        Identifier="RootDialog"
        SnackbarMessageQueue="{Binding ElementName=MainSnackbar, Path=MessageQueue}"
        Style="{StaticResource MaterialDesignEmbeddedDialogHost}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="colSidebar" Width="260" MinWidth="180" MaxWidth="360" />
                <ColumnDefinition Width="6" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Ambient glows (AoGPN design background) -->
            <Grid
                Grid.ColumnSpan="3"
                Grid.RowSpan="2"
                IsHitTestVisible="False">
                <Ellipse
                    Width="560"
                    Height="440"
                    Margin="0,-180,-180,0"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Opacity="0.55">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#2E7C4DFF" />
                            <GradientStop Offset="1" Color="#007C4DFF" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
                <Ellipse
                    Width="520"
                    Height="420"
                    Margin="-200,0,0,-160"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Bottom"
                    Opacity="0.5">
                    <Ellipse.Fill>
                        <RadialGradientBrush>
                            <GradientStop Offset="0" Color="#2600B8D4" />
                            <GradientStop Offset="1" Color="#0000B8D4" />
                        </RadialGradientBrush>
                    </Ellipse.Fill>
                </Ellipse>
            </Grid>

            <DockPanel Grid.Column="2" Grid.Row="0" Height="60" Grid.RowSpan="2" VerticalAlignment="Top">
                <Border
                    DockPanel.Dock="Top"
                    Style="{StaticResource ModernCard}"
                    Margin="10,8,10,4"
                    Padding="10,6"
                    Background="{StaticResource GlassHeaderBg}"
                    BorderBrush="{StaticResource GlassEdgeBrush}"
                    BorderThickness="1">
                    <Border.Effect>
                        <DropShadowEffect
                            BlurRadius="22"
                            Direction="270"
                            Opacity="0.4"
                            ShadowDepth="4"
                            Color="#7C4DFF" />
                    </Border.Effect>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border
                                Width="26"
                                Height="26"
                                Background="{StaticResource GpnNeonGradient}"
                                CornerRadius="9">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="ShieldCheckOutline" />
                            </Border>
                            <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="{DynamicResource StdFontSize4}"
                                    FontWeight="SemiBold"
                                    Foreground="{StaticResource BrandTextGradient}"
                                    Text="AO GPN" />
                                <TextBlock
                                    Opacity="0.65"
                                    Style="{StaticResource ToolbarTextBlock}"
                                    Text="{x:Static resx:ResUI.ModernSubtitle}" />
                            </StackPanel>
                        </StackPanel>
                        <ContentControl
                            x:Name="contentStatusBarView"
                            Grid.Column="1"
                            Margin="14,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center" />
                    </Grid>
                </Border>

            </DockPanel>
            <GridSplitter
                Grid.Column="1"
                Grid.RowSpan="2"
                Width="6"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch"
                Background="Transparent" />
            <Border
                Grid.Column="0"
                Grid.RowSpan="2"
                Margin="10,4,4,8"
                Padding="10,14"
                Background="#F20D111C"
                BorderBrush="#26FFFFFF"
                BorderThickness="1"
                CornerRadius="16">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="18"
                        Opacity="0.12"
                        ShadowDepth="2" />
                </Border.Effect>
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom">
                        <Separator Margin="4,10" Opacity="0.35" />
                        <!-- Direct theme selector — no expander needed -->
                        <Border
                            Margin="2,2,2,6"
                            Padding="8,10"
                            Background="#14FFFFFF"
                            BorderBrush="#1DFFFFFF"
                            BorderThickness="1"
                            CornerRadius="10">
                            <StackPanel>
                                <TextBlock
                                    Margin="0,0,0,4"
                                    FontSize="11"
                                    Foreground="#88909E"
                                    Text="{x:Static resx:ResUI.ModernNavTheme}" />
                                <ComboBox
                                    x:Name="cmbSidebarTheme"
                                    Width="Auto"
                                    AutomationProperties.Name="{x:Static resx:ResUI.ModernNavTheme}"
                                    FontSize="{DynamicResource StdFontSize}"
                                    Style="{StaticResource MaterialDesignFilledComboBox}" />
                            </StackPanel>
                        </Border>
                        <TextBlock
                            Margin="12,4"
                            Opacity="0.45"
                            Style="{StaticResource ListItemSubTitle2}"
                            Text="{x:Static resx:ResUI.ModernFooter}" />
                    </StackPanel>
                    <ScrollViewer
                        VerticalScrollBarVisibility="Auto"
                        HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <!-- Brand -->
                            <StackPanel Margin="4,2,4,18" Orientation="Horizontal">
                                <Border Width="38" Height="38" CornerRadius="12" Background="{StaticResource GpnNeonGradient}">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="14"
                                            Color="#7C4DFF"
                                            Opacity="0.6"
                                            ShadowDepth="0" />
                                    </Border.Effect>
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Foreground="White"
                                        Kind="ShieldCheckOutline" />
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock
                                        FontSize="20"
                                        FontWeight="Bold"
                                        Foreground="{StaticResource BrandTextGradient}"
                                        Text="AO GPN" />
                                    <TextBlock
                                        Margin="0,1,0,0"
                                        FontSize="9"
                                        Foreground="#8A94A6"
                                        Text="GAMING PRIVATE NETWORK" />
                                </StackPanel>
                            </StackPanel>

                            <TextBlock Style="{StaticResource ModernNavCaption}" Text="{x:Static resx:ResUI.ModernNavMenu}" />
                            <Button x:Name="btnNavConnection" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Kind="ViewDashboardOutline" />
                                    <TextBlock Margin="12,0,0,0" FontSize="13" Text="{x:Static resx:ResUI.ConnectionTitle}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavGameBoost" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Kind="LightningBoltOutline" />
                                    <TextBlock Margin="12,0,0,0" FontSize="13" Text="GPN Game Boost" />
                                    <Border Margin="10,0,0,0" Padding="6,1" CornerRadius="6" Background="#267C4DFF">
                                        <TextBlock FontSize="9" FontWeight="Bold" Foreground="#C4B5FD" Text="NEW" />
                                    </Border>
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavConnections" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Kind="Speedometer" />
                                    <TextBlock Margin="12,0,0,0" FontSize="13" Text="Performance" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="btnNavSettings" Style="{StaticResource SidebarNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Kind="CogOutline" />
                                    <TextBlock Margin="12,0,0,0" FontSize="13" Text="{x:Static resx:ResUI.menuOptionSetting}" />
                                </StackPanel>
                            </Button>

                            <TextBlock Style="{StaticResource ModernNavCaption}" Text="{x:Static resx:ResUI.ModernNavConnMode}" />
                            <Border
                                Margin="0,4,0,6"
                                Padding="8,10"
                                Background="#14FFFFFF"
                                BorderBrush="#1DFFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        FontSize="11"
                                        Foreground="#88909E"
                                        Text="{x:Static resx:ResUI.menuSystemproxy}" />
                                    <ComboBox
                                        x:Name="cmbSideSystemProxy"
                                        Width="Auto"
                                        materialDesign:HintAssist.Hint="{x:Static resx:ResUI.menuSystemproxy}"
                                        AutomationProperties.Name="{x:Static resx:ResUI.menuSystemproxy}"
                                        FontSize="{DynamicResource StdFontSize}"
                                        Style="{StaticResource MaterialDesignFilledComboBox}">
                                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyClear}" />
                                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxySet}" />
                                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyNothing}" />
                                        <ComboBoxItem Content="{x:Static resx:ResUI.menuSystemProxyPac}" />
                                    </ComboBox>
                                    <Separator Margin="0,8" Opacity="0.2" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            Foreground="#88909E"
                                            Text="{x:Static resx:ResUI.TbEnableTunAs}" />
                                        <ToggleButton
                                            x:Name="togSideTun"
                                            Margin="10,0,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            AutomationProperties.Name="{x:Static resx:ResUI.TbEnableTunAs}"
                                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <TextBlock Style="{StaticResource ModernNavCaption}" Text="{x:Static resx:ResUI.ModernNavConfig}" />
                            <Expander
                                x:Name="expMoreTools"
                                Margin="0,2,0,0"
                                Header="{x:Static resx:ResUI.ModernNavMoreTools}"
                                IsExpanded="False">
                                <StackPanel>
                                    <Button x:Name="btnNavImport" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="ContentPaste" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.menuAddServerViaClipboard}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNavScan" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="QrcodeScan" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.menuAddServerViaScan}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNavProxies" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="ShieldSyncOutline" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.TbProxies}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNavMsg" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="MessageTextOutline" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNavRouting" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="RouterNetwork" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.menuRoutingSetting}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="btnNavDNS" Style="{StaticResource SidebarNavButton}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="20" Kind="DnsOutline" />
                                            <TextBlock Margin="12,0,0,0" TextWrapping="Wrap" Text="{x:Static resx:ResUI.menuDNSSetting}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <DockPanel Grid.Column="2" Grid.Row="1">
                <Grid>
                    <Grid x:Name="gridMain" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="1*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="tabProfiles"
                            Grid.Column="0"
                            Style="{StaticResource ModernSurfaceControl}" />
                        <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain"
                            Grid.Column="2"
                            Margin="8"
                            Background="Transparent"
                            BorderThickness="0">
                            <TabItem x:Name="tabMsgView" Header="{x:Static resx:ResUI.MsgInformationTitle}" />
                            <TabItem x:Name="tabClashProxies" Header="{x:Static resx:ResUI.TbProxies}" />
                            <TabItem x:Name="tabClashConnections" Header="{x:Static resx:ResUI.TbConnections}" />
                            <TabItem x:Name="tabConnectionMonitor" Header="{x:Static resx:ResUI.menuMonitor}" />
                            <TabItem x:Name="tabGaming" Header="GPN 2.0" />
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain1" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="10" />
                            <RowDefinition Height="1*" />
                        </Grid.RowDefinitions>
                        <ContentControl x:Name="tabProfiles1" Grid.Row="0" />
                        <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" />
                        <TabControl
                            x:Name="tabMain1"
                            Grid.Row="2"
                            materialDesign:NavigationRailAssist.ShowSelectionBackground="True"
                            Style="{StaticResource MaterialDesignNavigationRailTabControl}"
                            TabStripPlacement="Left">
                            <TabItem x:Name="tabMsgView1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabConnectionMonitor1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="Eye" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.menuMonitor}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabGaming1">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="GamepadVariant" />
                                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource ToolbarTextBlock}" Text="GPN 2.0" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <Grid x:Name="gridMain2" Visibility="Collapsed">
                        <TabControl x:Name="tabMain2" TabStripPlacement="Top">
                            <TabControl.Resources>
                                <Style TargetType="{x:Type TabPanel}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Style>
                            </TabControl.Resources>
                            <TabItem x:Name="tabMsgView2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="MessageTextOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.MsgInformationTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashProxies2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="ArrowDecisionOutline" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbProxies}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabClashConnections2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="LanConnect" />
                                        <TextBlock
                                            HorizontalAlignment="Center"
                                            Style="{StaticResource ToolbarTextBlock}"
                                            Text="{x:Static resx:ResUI.TbConnections}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                            <TabItem x:Name="tabConnection2">
                                <TabItem.Header>
                                    <StackPanel>
                                        <materialDesign:PackIcon HorizontalAlignment="Center" Kind="RouterWireless" />
                                        <TextBlock HorizontalAlignment="Center" Style="{StaticResource ToolbarTextBlock}" Text="{x:Static resx:ResUI.ConnectionTitle}" />
                                    </StackPanel>
                                </TabItem.Header>
                            </TabItem>
                        </TabControl>
                    </Grid>
                    <materialDesign:Snackbar x:Name="MainSnackbar" MessageQueue="{materialDesign:MessageQueue}" />
                </Grid>
            </DockPanel>
        </Grid>
        </materialDesign:DialogHost>
        <!-- WebView2 is deliberately the only visible child and fills the client area.
             It starts Hidden: the window is shown at Opacity 0 during startup, and WPF
             window opacity does not reach a native child HWND (WebView2 airspace), so
             the browser surface would otherwise paint its empty dark frame over the
             desktop for the whole boot. Hidden keeps the control laid out (WebView2 can
             still initialize and load the dashboard); RevealStartupWindow makes it
             visible once the dashboard has rendered. -->
        <wv2:WebView2
            x:Name="WebView"
            Panel.ZIndex="10"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Stretch"
            Visibility="Hidden"
            Focusable="True" />
    </Grid>
</base:WindowBase>
