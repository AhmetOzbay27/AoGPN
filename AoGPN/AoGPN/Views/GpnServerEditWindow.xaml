<base:WindowBase
    x:Class="AoGPN.Views.GpnServerEditWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:AoGPN.Base"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    Title="{Binding WindowTitle}"
    Width="520"
    Height="560"
    x:TypeArguments="vms:GpnServerEditViewModel"
    ShowInTaskbar="False"
    Style="{StaticResource WindowGlobal}"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <DockPanel Margin="{StaticResource Margin8}">
        <StackPanel
            Margin="{StaticResource Margin4}"
            HorizontalAlignment="Right"
            DockPanel.Dock="Bottom"
            Orientation="Horizontal">
            <Button
                x:Name="btnSave"
                Width="100"
                Content="{x:Static resx:ResUI.TbConfirm}"
                IsDefault="True"
                Style="{StaticResource DefButton}" />
            <Button
                x:Name="btnCancel"
                Width="100"
                Margin="{StaticResource MarginLeftRight8}"
                Content="{x:Static resx:ResUI.TbCancel}"
                IsCancel="true"
                Style="{StaticResource DefButton}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="{StaticResource Margin4}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Row="0"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColName}" />
                <TextBox
                    x:Name="txtName"
                    Grid.Row="0"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <TextBlock
                    Grid.Row="1"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColEndpoint}" />
                <StackPanel
                    Grid.Row="1"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="txtEndpointHost"
                        MinWidth="220"
                        VerticalAlignment="Center"
                        Style="{StaticResource DefTextBox}" />
                    <TextBox
                        x:Name="txtEndpointPort"
                        Width="70"
                        Margin="{StaticResource MarginLeftRight8}"
                        VerticalAlignment="Center"
                        Style="{StaticResource DefTextBox}" />
                </StackPanel>

                <TextBlock
                    Grid.Row="2"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColPublicKey}" />
                <TextBox
                    x:Name="txtServerPublicKey"
                    Grid.Row="2"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <TextBlock
                    Grid.Row="3"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColPrivateKey}" />
                <StackPanel
                    Grid.Row="3"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    Orientation="Horizontal">
                    <TextBox
                        x:Name="txtClientPrivateKey"
                        MinWidth="220"
                        VerticalAlignment="Center"
                        Style="{StaticResource DefTextBox}" />
                    <Button
                        x:Name="btnGenerateKey"
                        Width="90"
                        Margin="{StaticResource MarginLeftRight8}"
                        Content="{x:Static resx:ResUI.GpnServerGenerateKey}"
                        Style="{StaticResource DefButton}" />
                </StackPanel>
                <TextBlock
                    Grid.Row="4"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    Opacity="0.6"
                    Style="{StaticResource ListItemSubTitle2}"
                    Text="{x:Static resx:ResUI.GpnServerPrivateKeyHint}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Grid.Row="5"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColAddress}" />
                <TextBox
                    x:Name="txtClientAddress"
                    Grid.Row="5"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <TextBlock
                    Grid.Row="6"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColMtu}" />
                <TextBox
                    x:Name="txtMtu"
                    Grid.Row="6"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    Width="100"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <TextBlock
                    Grid.Row="7"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColDns}" />
                <TextBox
                    x:Name="txtDns"
                    Grid.Row="7"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    Width="180"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <TextBlock
                    Grid.Row="8"
                    Grid.Column="0"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.GpnServerColKeepalive}" />
                <TextBox
                    x:Name="txtKeepalive"
                    Grid.Row="8"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    HorizontalAlignment="Left"
                    Width="100"
                    VerticalAlignment="Center"
                    Style="{StaticResource DefTextBox}" />

                <CheckBox
                    x:Name="chkEnabled"
                    Grid.Row="9"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    VerticalAlignment="Center"
                    Content="{x:Static resx:ResUI.TrayStatusConnected}" />

                <TextBlock
                    Grid.Row="10"
                    Grid.Column="1"
                    Margin="{StaticResource Margin4}"
                    Opacity="0.6"
                    Style="{StaticResource ListItemSubTitle2}"
                    Text="🔐 DPAPI"
                    TextWrapping="Wrap" />
            </Grid>
        </ScrollViewer>
    </DockPanel>
</base:WindowBase>
