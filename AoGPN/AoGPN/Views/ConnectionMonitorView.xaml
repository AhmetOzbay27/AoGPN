<reactiveui:ReactiveUserControl
    x:Class="AoGPN.Views.ConnectionMonitorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:AoGPN.Controls"
    xmlns:conv="clr-namespace:AoGPN.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:ConnectionMonitorViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">

    <DockPanel Margin="{StaticResource Margin8}">
        <DockPanel.Resources>
            <conv:ExePathToIconConverter x:Key="ExeIcon" />
        </DockPanel.Resources>

        <Border
            Margin="0,0,0,10"
            Padding="18,16"
            Background="{DynamicResource MaterialDesignPaper}"
            BorderBrush="{DynamicResource MaterialDesignDivider}"
            BorderThickness="1"
            CornerRadius="18"
            DockPanel.Dock="Top">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="24"
                            Height="24"
                            Margin="0,0,10,0"
                            Foreground="{DynamicResource MaterialDesign.Brush.Secondary}"
                            Kind="ChartTimelineVariant" />
                        <TextBlock
                            FontSize="{DynamicResource StdFontSize9}"
                            FontWeight="SemiBold"
                            Text="{x:Static resx:ResUI.menuMonitor}" />
                    </StackPanel>
                    <TextBlock
                        Margin="34,5,0,0"
                        Opacity="0.65"
                        Style="{StaticResource ListItemSubTitle2}"
                        Text="{x:Static resx:ResUI.MonitorHint}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Border
                    Grid.Column="1"
                    MinWidth="118"
                    Margin="12,0,0,0"
                    Padding="14,8"
                    Background="{DynamicResource MaterialDesign.Brush.Primary.Light}"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.7" Text="{x:Static resx:ResUI.MonitorConnectionsTab}" />
                        <TextBlock FontSize="{DynamicResource StdFontSize10}" FontWeight="SemiBold" Text="{Binding ActiveConnectionCount}" />
                    </StackPanel>
                </Border>
                <Border
                    Grid.Column="2"
                    MinWidth="118"
                    Margin="10,0,0,0"
                    Padding="14,8"
                    Background="{DynamicResource MaterialDesign.Brush.Secondary.Light}"
                    CornerRadius="12">
                    <StackPanel>
                        <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.7" Text="{x:Static resx:ResUI.MonitorAppsTab}" />
                        <TextBlock FontSize="{DynamicResource StdFontSize10}" FontWeight="SemiBold" Text="{Binding ActiveAppCount}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <WrapPanel
            Margin="0,0,0,4"
            DockPanel.Dock="Top">
            <TextBox
                x:Name="txtFilter"
                Width="240"
                MinWidth="160"
                MaxWidth="340"
                Margin="0,0,8,8"
                VerticalContentAlignment="Center"
                materialDesign:HintAssist.Hint="{x:Static resx:ResUI.MonitorFilterHint}"
                materialDesign:TextFieldAssist.HasClearButton="True"
                Style="{StaticResource DefTextBox}" />
            <Button
                x:Name="btnRefresh"
                Width="24"
                Height="24"
                Margin="8,0,8,8"
                Style="{StaticResource MaterialDesignFloatingActionMiniLightButton}"
                ToolTip="{x:Static resx:ResUI.SplitTunnelRefresh}">
                <materialDesign:PackIcon VerticalAlignment="Center" Kind="Refresh" />
            </Button>
            <CheckBox
                x:Name="chkHideListeners"
                Margin="8,0,8,8"
                VerticalAlignment="Center"
                Content="{x:Static resx:ResUI.MonitorHideListeners}"
                Style="{StaticResource ListItemCheckBox}" />
            <StackPanel
                Margin="8,0,8,8"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <TextBlock
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Style="{StaticResource ToolbarTextBlock}"
                    Text="{x:Static resx:ResUI.TbAutoRefresh}" />
                <ToggleButton
                    x:Name="togAutoRefresh"
                    VerticalAlignment="Center" />
            </StackPanel>
        </WrapPanel>

        <TabControl
            x:Name="tabTrafficView"
            Margin="0"
            Background="Transparent"
            BorderThickness="0"
            DockPanel.Dock="Top">
            <TabItem x:Name="tabConnections" Header="{x:Static resx:ResUI.MonitorConnectionsTab}">
                <DataGrid
                    x:Name="lstConnections"
                    AutoGenerateColumns="False"
                    BorderThickness="0"
                    HorizontalScrollBarVisibility="Disabled"
                    CanUserAddRows="False"
                    CanUserResizeRows="False"
                    EnableRowVirtualization="True"
                    GridLinesVisibility="None"
                    HeadersVisibility="Column"
                    IsReadOnly="True"
                    SelectionMode="Single"
                    Style="{StaticResource DefDataGrid}">
                    <DataGrid.ContextMenu>
                        <ContextMenu Style="{StaticResource DefContextMenu}">
                            <MenuItem x:Name="menuCopyAddress" Header="{x:Static resx:ResUI.MonitorCopyAddress}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="2*" Header="{x:Static resx:ResUI.SplitTunnelColApp}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3" Orientation="Horizontal">
                                        <Image Width="16" Height="16" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" />
                                        <StackPanel Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            <TextBlock FontSize="{DynamicResource StdFontSize-1}" Opacity="0.55" Text="{Binding ProcessName}" />
                                        </StackPanel>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTemplateColumn Width="1.1*" Header="{x:Static resx:ResUI.MonitorColRoute}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Margin="3,3" Padding="8,1" CornerRadius="8">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#FF607D8B" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding RouteTag}" Value="proxy"><Setter Property="Background" Value="#FF1565C0" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding RouteTag}" Value="direct"><Setter Property="Background" Value="#FF2E7D32" /></DataTrigger>
                                                    <DataTrigger Binding="{Binding RouteTag}" Value="block"><Setter Property="Background" Value="#FFC62828" /></DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock HorizontalAlignment="Center" Foreground="White" Text="{Binding RouteText}" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="1.1*" Binding="{Binding Protocol}" Header="{x:Static resx:ResUI.MonitorColProtocol}" />
                        <DataGridTextColumn Width="1.6*" Binding="{Binding RemoteAddress}" Header="{x:Static resx:ResUI.MonitorColRemote}" />
                        <DataGridTemplateColumn Width="1.0*" Header="{x:Static resx:ResUI.MonitorColCountry}">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="4,3" Orientation="Horizontal" ToolTip="{Binding CountryName}">
                                        <TextBlock Text="{Binding CountryText}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Width="1.6*" Binding="{Binding AsnText}" Header="{x:Static resx:ResUI.MonitorColAsn}" />
                        <DataGridTextColumn Width="1.1*" Binding="{Binding State}" Header="{x:Static resx:ResUI.MonitorColState}" />
                        <DataGridTextColumn Width="0.8*" Binding="{Binding Pid}" Header="PID" />
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem x:Name="tabApps" Header="{x:Static resx:ResUI.MonitorAppsTab}">
                <DockPanel>
                    <TextBlock Margin="{StaticResource Margin8}" DockPanel.Dock="Top" Text="{Binding TrafficStatus}" />
                    <DataGrid
                        x:Name="lstAppTraffic"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalScrollBarVisibility="Disabled"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        Style="{StaticResource DefDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="2*" Header="{x:Static resx:ResUI.SplitTunnelColApp}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3" Orientation="Horizontal">
                                            <Image Width="16" Height="16" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding AppName}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Width="1.3*" Binding="{Binding DownloadText}" Header="{x:Static resx:ResUI.TbSortingDownTraffic}" />
                            <DataGridTextColumn Width="1.3*" Binding="{Binding UploadText}" Header="{x:Static resx:ResUI.TbSortingUpTraffic}" />
                            <DataGridTextColumn Width="1.1*" Binding="{Binding ConnectionCount}" Header="{x:Static resx:ResUI.TbConnections}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="tabTraffic" Header="{x:Static resx:ResUI.MonitorTrafficTab}">
                <DockPanel>
                    <WrapPanel Margin="{StaticResource Margin8}" DockPanel.Dock="Top">
                        <TextBox
                            x:Name="txtTrafficFilter"
                            Width="240"
                            MinWidth="160"
                            MaxWidth="340"
                            Margin="0,0,8,8"
                            VerticalContentAlignment="Center"
                            materialDesign:HintAssist.Hint="{x:Static resx:ResUI.MonitorFilterHint}"
                            materialDesign:TextFieldAssist.HasClearButton="True"
                            Style="{StaticResource DefTextBox}" />
                        <StackPanel Margin="8,0,8,8" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="↓ " />
                            <TextBlock Text="{Binding TotalDownloadText}" />
                        </StackPanel>
                        <StackPanel Margin="8,0,8,8" VerticalAlignment="Center" Orientation="Horizontal">
                            <TextBlock Text="↑ " />
                            <TextBlock Text="{Binding TotalUploadText}" />
                        </StackPanel>
                        <Button
                            x:Name="btnClearTraffic"
                            Margin="8,0,8,8"
                            Content="{x:Static resx:ResUI.TbReset}"
                            Style="{StaticResource DefButton}" />
                    </WrapPanel>
                    <TextBlock Margin="{StaticResource MarginLeftRight8}" DockPanel.Dock="Bottom" Opacity="0.65" Text="{Binding TrafficStatus}" />
                    <DataGrid
                        x:Name="lstTraffic"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        HorizontalScrollBarVisibility="Disabled"
                        CanUserResizeRows="False"
                        HeadersVisibility="Column"
                        IsReadOnly="True"
                        Style="{StaticResource DefDataGrid}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*" Binding="{Binding Type}" Header="{x:Static resx:ResUI.TbSortingType}" />
                            <DataGridTextColumn Width="1.3*" Binding="{Binding DownloadText}" Header="{x:Static resx:ResUI.TbSortingDownTraffic}" />
                            <DataGridTextColumn Width="1.3*" Binding="{Binding UploadText}" Header="{x:Static resx:ResUI.TbSortingUpTraffic}" />
                            <DataGridTemplateColumn Width="1.2*" Header="{x:Static resx:ResUI.SplitTunnelColApp}">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="4,3" Orientation="Horizontal">
                                            <Image Width="16" Height="16" Source="{Binding ExePath, Converter={StaticResource ExeIcon}}" />
                                            <TextBlock Margin="8,0,0,0" VerticalAlignment="Center" Text="{Binding AppName}" />
                                            <TextBlock Margin="6,0,0,0" VerticalAlignment="Center" Opacity="0.65" Text="{Binding AppCountText}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <TabItem x:Name="tabWorld" Header="{x:Static resx:ResUI.MonitorWorldTab}">
                <DockPanel>
                    <Grid Margin="0" DockPanel.Dock="Bottom" Height="200">
                        <DataGrid
                            x:Name="lstCountries"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserResizeRows="False"
                            HeadersVisibility="Column"
                            IsReadOnly="True"
                            Style="{StaticResource DefDataGrid}">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2.2*" Header="{x:Static resx:ResUI.MonitorColCountry}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="4,3" Orientation="Horizontal" ToolTip="{Binding CountryName}">
                                                <TextBlock Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Width="1.0*" Binding="{Binding ConnectionCount}" Header="{x:Static resx:ResUI.TbConnections}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding DownloadText}" Header="{x:Static resx:ResUI.TbSortingDownTraffic}" />
                                <DataGridTextColumn Width="1.1*" Binding="{Binding UploadText}" Header="{x:Static resx:ResUI.TbSortingUpTraffic}" />
                                <DataGridTextColumn Width="1.0*" Binding="{Binding AppCount}" Header="{x:Static resx:ResUI.MonitorColApps}" />
                                <DataGridTextColumn Width="2.4*" Binding="{Binding AsnText}" Header="{x:Static resx:ResUI.MonitorColAsn}" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                    <Border Margin="0,0,0,8" Background="{DynamicResource MaterialDesignPaper}" CornerRadius="14">
                        <controls:WorldMapControl x:Name="mapWorld" Items="{Binding CountryItems}" />
                    </Border>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</reactiveui:ReactiveUserControl>
